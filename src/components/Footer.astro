---
import { Image } from "astro:assets";
import logo from "../assets/images/Logotipo.png";
import yelpIcon from "../assets/images/yelp-svgrepo-com.svg";
---

<footer class="bg-zinc-950 border-t border-white/10 pt-16 pb-8">
    <div class="container mx-auto px-6">
        <div
            class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-5 gap-12 mb-12"
        >
            <div class="col-span-1 sm:col-span-2 md:col-span-2">
                <a href="/" class="block mb-6">
                    <Image
                        src={logo}
                        alt="HRZ Wheel Repair Logo - Expert Mobile Wheel Repair in Los Angeles & Orange County"
                        title="HRZ Wheel Repair - Professional Alloy Wheel Repair & Curb Rash Repair"
                        class="h-16 w-auto"
                    />
                </a>
                <p class="text-gray-300 text-sm leading-relaxed max-w-md mb-6">
                    Premier mobile wheel repair service in Los Angeles and
                    Orange County. Professional alloy wheel repair, curb rash
                    refinishing, and bumper spot repair. We restore the beauty
                    and value of your vehicle with precision and care. Same-day
                    service available.
                </p>
                <div class="flex space-x-4">
                    <!-- YouTube -->
                    <a
                        href="http://YouTube.com/@HRZwheelofficial"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center text-white hover:bg-gold-500 hover:text-black transition-all"
                        aria-label="Visit our YouTube channel"
                    >
                        <svg
                            class="w-5 h-5"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                        >
                            <path
                                d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"
                            ></path>
                        </svg>
                    </a>
                    <!-- Facebook -->
                    <a
                        href="#"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center text-white hover:bg-gold-500 hover:text-black transition-all"
                        aria-label="Visit our Facebook page"
                    >
                        <svg
                            class="w-5 h-5"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                        >
                            <path
                                d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
                            ></path>
                        </svg>
                    </a>
                    <!-- Instagram -->
                    <a
                        href="#"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center text-white hover:bg-gold-500 hover:text-black transition-all"
                        aria-label="Visit our Instagram page"
                    >
                        <svg
                            class="w-5 h-5"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                        >
                            <path
                                d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z"
                            ></path>
                        </svg>
                    </a>
                    <!-- Yelp -->
                    <a
                        href="https://www.yelp.com/biz/hrz-wheel-repair-hacienda-heights-10"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center text-white hover:bg-gold-500 hover:text-black transition-all"
                        aria-label="Read our Yelp reviews"
                    >
                        <Image
                            src={yelpIcon}
                            alt="Yelp"
                            title="Read HRZ Wheel Repair reviews on Yelp"
                            class="w-5 h-5 brightness-0 invert"
                        />
                    </a>
                </div>
            </div>

            <div>
                <h3 class="text-white font-bold mb-6">Services</h3>
                <ul class="space-y-3 text-sm text-gray-300">
                    <li>
                        <a
                            href="/#services"
                            class="hover:text-gold-500 transition-colors"
                            >Curb Rash Repair</a
                        >
                    </li>

                    <li>
                        <a
                            href="/#services"
                            class="hover:text-gold-500 transition-colors"
                            >Rim Refinishing</a
                        >
                    </li>
                    <li>
                        <a
                            href="/quote"
                            class="hover:text-gold-500 transition-colors"
                            >Lease Return Fix</a
                        >
                    </li>
                    <li>
                        <a
                            href="/#services"
                            class="hover:text-gold-500 transition-colors"
                            >1 Year Guarantee</a
                        >
                    </li>
                </ul>
            </div>

            <div>
                <h3 class="text-white font-bold mb-6">Contact</h3>
                <ul class="space-y-3 text-sm text-gray-300">
                    <li class="flex items-start">
                        <span class="text-gold-500 mr-2">📍</span>
                        Serving Los Angeles & <br />Orange County
                    </li>
                    <li class="flex items-center">
                        <span class="text-gold-500 mr-2">📞</span>
                        <a
                            href="tel:+16268632885"
                            class="hover:text-white transition-colors"
                            >(626) 863-2885</a
                        >
                    </li>
                    <li class="flex items-center">
                        <span class="text-gold-500 mr-2">✉️</span>
                        <a
                            href="mailto:hector@hrzwheel.com"
                            class="hover:text-white transition-colors"
                            >hector@hrzwheel.com</a
                        >
                    </li>
                </ul>
            </div>

            <div>
                <h3 class="text-white font-bold mb-6">Business Hours</h3>
                <ul class="space-y-3 text-sm text-gray-300">
                    <li class="flex items-start">
                        <span class="text-gold-500 mr-2">🕒</span>
                        <div>
                            <div>Mon - Fri</div>
                            <div class="text-gray-400">9:00 am - 5:00 pm</div>
                        </div>
                    </li>
                    <li class="flex items-start">
                        <span class="text-gold-500 mr-2">🕒</span>
                        <div>
                            <div>Sat</div>
                            <div class="text-gray-400">9:00 am - 2:00 pm</div>
                        </div>
                    </li>
                </ul>
            </div>
        </div>

        <div
            class="border-t border-white/5 pt-8 relative flex flex-col md:flex-row justify-between items-center text-xs text-gray-400 gap-4"
        >
            <p class="order-1">
                &copy; {new Date().getFullYear()} HRZ Wheel Repair. All rights reserved.
            </p>
            <p class="order-2 md:absolute md:left-1/2 md:-translate-x-1/2">
                Website developed with <span class="text-red-500">❤️</span> by
                <a
                    href="https://vruju.com"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-gray-400 hover:text-gold-500 transition-colors font-medium"
                >
                    Vruju
                </a>
            </p>
            <div class="flex space-x-6 order-3">
                <a href="/quote" class="hover:text-gray-200">Privacy Policy</a>
                <a href="/quote" class="hover:text-gray-200">Terms of Service</a
                >
            </div>
        </div>
    </div>
</footer>
