---
import { Image } from "astro:assets";
import rimWheelHero from "../assets/images/Gallery/Rim wheel.png";
import logo from "../assets/images/Logotipo.png";
import yelpIcon from "../assets/images/yelp-svgrepo-com.svg";
import yelpLogo from "../assets/images/yelp_logo.png";
---

<section
    class="relative min-h-screen flex items-center justify-center overflow-hidden pt-20"
>
    <!-- Background with gradient overlay -->
    <div class="absolute inset-0 z-0">
        <!-- Golden Glow Effect -->
        <div
            class="absolute inset-0 bg-[radial-gradient(circle_at_50%_30%,rgba(212,175,55,0.15),transparent_70%)] z-20 pointer-events-none"
        >
        </div>

        <div
            class="absolute inset-0 bg-gradient-to-b from-black/80 via-black/60 to-black z-10"
        >
        </div>
        <!-- Rim Wheel Background Image - LCP optimization -->
        <Image
            src={rimWheelHero}
            alt="Professional alloy wheel repair service showcasing scratched and scuffed wheels restoration in Los Angeles and Orange County - HRZ Wheel Repair"
            title="Expert Alloy Wheel Repair - Scratched & Scuffed Wheels Restoration - Mobile Service Available"
            class="absolute inset-0 w-full h-full object-cover opacity-50"
            widths={[640, 828, 1200, 1920]}
            sizes="100vw"
            loading="eager"
            fetchpriority="high"
            format="webp"
            quality={80}
        />
    </div>

    <div class="container mx-auto px-2 sm:px-6 relative z-20 text-center">
        <!-- Logo -->
        <div class="flex justify-center mb-8">
            <Image
                src={logo}
                alt="HRZ Wheel  - Professional Mobile Alloy Wheel Repair in Los Angeles & Orange County"
                title="HRZ Wheel  - Expert Alloy Wheel Repair & Curb Rash Repair"
                class="h-48 md:h-64 w-auto drop-shadow-[0_0_15px_rgba(212,175,55,0.3)]"
                loading="eager"
                width={300}
                height={256}
                format="webp"
                quality={85}
            />
        </div>

      <h1
    class="text-4xl md:text-5xl lg:text-7xl font-display font-bold text-white mb-6 leading-tight tracking-tighter sm:tracking-normal"
>
    HRZ Wheel <span
        class="animate-shine bg-clip-text text-transparent bg-[linear-gradient(to_right,#B5952F,#F9E588,#FDF3B7,#B5952F)] bg-[length:200%_auto]"
        >Repair</span
    >
</h1>

<h2 class="text-lg md:text-xl lg:text-2xl text-gray-300 font-light mt-4 mb-2 max-w-2xl mx-auto">
    Mobile Wheel Repair in Hacienda Heights, Los Angeles & Orange County
</h2>

<p class="text-gray-300 text-base md:text-xl max-w-2xl mx-auto mb-10 font-light">
    Expert mobile repair for scratched or scuffed wheels across Los
    Angeles & Orange County. Professional alloy wheel repair, curb rash
    repair, bumper spot paint, and wheel restoration.
</p>


        <p
            class="text-gray-300 text-base md:text-xl max-w-2xl mx-auto mb-10 font-light"
        >
            Expert mobile repair for scratched or scuffed wheels across Los
            Angeles & Orange County. Professional alloy wheel repair, curb rash
            repair, bumper spot paint, and wheel restoration.
        </p>

        <div
            class="flex flex-col sm:flex-row gap-6 justify-center items-center"
        >
            <a
                href="/quote"
                class="w-full sm:w-auto bg-gold-500 hover:bg-gold-400 text-black px-8 py-4 rounded-full font-bold text-lg transition-all transform hover:scale-105 shadow-[0_0_20px_rgba(212,175,55,0.3)]"
            >
                Request a Free Quote
            </a>
            <a
                href="https://www.yelp.com/biz/hrz-wheel-repair-hacienda-heights-10"
                target="_blank"
                rel="noopener noreferrer"
                class="w-full sm:w-auto flex justify-center items-center hover:scale-110 transition-transform duration-300"
            >
                <Image
                    src={yelpLogo}
                    alt="Visit HRZ Wheel Repair on Yelp"
                    class="h-16 sm:h-20 w-auto object-contain drop-shadow-lg"
                />
            </a>
        </div>

        <!-- Trust Indicators -->
        <div
            class="mt-12 md:mt-16 flex flex-wrap justify-center items-center gap-4 md:gap-8 text-gray-400 grayscale opacity-70 px-4"
        >
            <!-- Icons or small logos could go here -->
            <span
                class="text-xs md:text-sm font-medium tracking-widest whitespace-nowrap"
                >LOS ANGELES</span
            >
            <span class="hidden sm:inline text-gold-500">•</span>
            <span
                class="text-xs md:text-sm font-medium tracking-widest whitespace-nowrap"
                >ORANGE COUNTY</span
            >
            <span class="hidden sm:inline text-gold-500">•</span>
            <span
                class="text-xs md:text-sm font-medium tracking-widest whitespace-nowrap"
                >SAME DAY SERVICE</span
            >
        </div>
    </div>
</section>

<style>
    .animate-shine {
        animation: shine 8s linear infinite;
        will-change: background-position;
        transform: translateZ(0);
        backface-visibility: hidden;
    }

    @keyframes shine {
        from {
            background-position: 0% center;
        }
        to {
            background-position: 200% center;
        }
    }
</style>
