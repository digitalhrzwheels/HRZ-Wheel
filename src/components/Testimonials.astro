---
import { Image } from "astro:assets";
import jesusAvatar from "../assets/testimonials/jesus v.jpg";
import kenAvatar from "../assets/testimonials/ken afriken.jpg";
import jtAvatar from "../assets/testimonials/j t.jpg";
import kristofAvatar from "../assets/testimonials/kristof.jpg";
import lilyAvatar from "../assets/testimonials/lyly c.jpg";
import mikeAvatar from "../assets/testimonials/mike w.jpg";
import jenAvatar from "../assets/testimonials/jen x.jpg";
import phillipAvatar from "../assets/testimonials/phillip l.jpg";
import favianAvatar from "../assets/testimonials/favian r.jpg";
import yelpLogo from "../assets/images/yelp-svgrepo-com.svg";

const testimonials = [
    {
        name: "Jesus V.",
        location: "Los Angeles, CA",
        rating: 5,
        text: "Absolutely blown away by the work. I had some curb rash that I thought would be impossible to fix without replacing the whole wheel but he made it look 99% brand new. What really stood out was that he let me check the work first before invoicing me. No pressure, just confident in the quality.",
        avatar: jesusAvatar,
        date: "Aug 2025"
    },
    {
        name: "AfriKen K.",
        location: "Highland, CA",
        rating: 5,
        text: "Hector not only got rid of my curb rash and made it look 100% brand new. He was kind and very professional. He showed up early and finished in shorter time than estimated. The curb rash was on my Tesla and his price was fair. I truly appreciated that he was mobile, so I was working in my house when he was working on my car.",
        avatar: kenAvatar,
        date: "2024"
    },
    {
        name: "J T.",
        location: "Newport Beach, CA",
        rating: 5,
        text: "Great service and quality job. Answered my inquiry within 30 mins. Set up my appointment and was on time. Knocked it out in under 1 hour. If anything else happens to my wheel I would definitely use Hector again.",
        avatar: jtAvatar,
        date: "2024"
    },
    {
        name: "Kristof A.",
        location: "Anaheim, CA",
        rating: 5,
        text: "My RAV4's rims accidentally were dinged up by a curb. Hector came by for our appointment and thoroughly went down his services. He assured he will try his best to match the color and he did perfectly! Honest man with honest work and amazing quality repairs.",
        avatar: kristofAvatar,
        date: "Oct 2022"
    },
    {
        name: "Lily C.",
        location: "Hacienda Heights, CA",
        rating: 5,
        text: "Great work, no hassle and very efficient. Called, set up appointment, responded to home. Rim looks amazing.",
        avatar: lilyAvatar,
        date: "Jul 2025"
    },
    {
        name: "Mike W.",
        location: "Torrance, CA",
        rating: 5,
        text: "Hector was great in repairing my Tesla curb damaged wheel. Friendly and professional. I will recommend to all my friends!",
        avatar: mikeAvatar,
        date: "Jun 2023"
    },
    {
        name: "Jen X.",
        location: "Madison, WI",
        rating: 5,
        text: "Hector was really nice and got the job done fast & perfectly! Great communication and I would definitely recommend to anyone :)",
        avatar: jenAvatar,
        date: "Aug 2022"
    },
    {
        name: "Phillip L.",
        location: "Covina, CA",
        rating: 5,
        text: "Hector is the man! He fixed a few small paint chips on my wheel caused by a mechanic. The price was great and the paint was matched properly. He was very prompt on his appointment and was done after 30 minutes. He does honest work and takes his time to make sure the wheels are in pristine condition. He also offers a 1 year warranty on his work.",
        avatar: phillipAvatar,
        date: "2024"
    },
    {
        name: "Favian R.",
        location: "Long Beach, CA",
        rating: 5,
        text: "I recently took my car to a tire shop and they scratched my wheel pretty nasty. So I scheduled my appointment with HRZ and was 100% satisfied. The owner was kind and very informative. The work only took about 45 minutes and was very reasonably priced.",
        avatar: favianAvatar,
        date: "Mar 2025"
    }
];
---

<section id="testimonials" class="pt-12 pb-20 lg:pt-16 lg:pb-24 bg-zinc-950 relative overflow-hidden">
    <!-- Enhanced Background Decoration with Multiple Layers -->
    <div class="absolute inset-0 pointer-events-none">
        <!-- Primary Golden Glow - Top Right -->
        <div
            class="absolute top-1/4 -right-32 w-[500px] h-[500px] bg-gold-500/15 rounded-full blur-[100px] animate-pulse-slow"
        >
        </div>

        <!-- Secondary Golden Accent -->
        <div
            class="absolute top-1/2 right-1/4 w-64 h-64 bg-gold-400/10 rounded-full blur-3xl"
        >
        </div>

        <!-- Primary Blue Glow - Bottom Left -->
        <div
            class="absolute bottom-1/4 -left-32 w-96 h-96 bg-bmw-blue/15 rounded-full blur-[100px] animate-pulse-slow"
            style="animation-delay: 1s;"
        >
        </div>

        <!-- Accent Blue Glow -->
        <div
            class="absolute top-1/3 left-1/4 w-48 h-48 bg-bmw-blue/8 rounded-full blur-3xl"
        >
        </div>

        <!-- Subtle Grid Pattern Overlay -->
        <div
            class="absolute inset-0 opacity-[0.02]"
            style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 50px 50px;"
        >
        </div>
    </div>

    <div class="container mx-auto px-6 relative z-10">
        <!-- Section Header -->
        <div class="text-center mb-8">
            <div class="inline-block mb-4 px-4 py-1 rounded-full border border-gold-500/30 bg-gold-500/10 backdrop-blur-sm">
                <span class="text-gold-400 text-xs font-bold tracking-widest uppercase">Verified Reviews</span>
            </div>
            <h2 class="text-4xl md:text-6xl font-display font-bold text-white mb-6 tracking-tight">
                What Our <span class="text-transparent bg-clip-text bg-gradient-to-r from-gold-400 to-white">Clients Say</span>
            </h2>
            <p class="text-gray-300 max-w-2xl mx-auto text-lg leading-relaxed mb-8">
                Real reviews from real customers. See why luxury car owners across LA and Orange County trust HRZ Wheel Repair.
            </p>
            
            <!-- Yelp Badges -->
            <div class="flex flex-wrap items-center justify-center gap-4">
                <!-- Rating Badge -->
                <a 
                    href="https://www.yelp.com/biz/hrz-wheel-repair-hacienda-heights-10" 
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-3 px-6 py-3 rounded-full bg-zinc-900 border border-white/10 hover:border-gold-500/50 transition-all duration-300 transform hover:scale-105"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6 text-gold-500">
                        <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.433 2.082-5.006z" clip-rule="evenodd" />
                    </svg>
                    <span class="text-white font-bold text-lg">4.9/5</span>
                    <span class="text-gray-300">•</span>
                    <span class="text-gray-300 text-sm">Based on 120+ Reviews</span>
                </a>

                <!-- Rate Us Button -->
                <a 
                    href="https://www.yelp.com/biz/hrz-wheel-repair-hacienda-heights-10" 
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#D32323] hover:bg-[#B81D1D] text-white font-bold transition-all duration-300 transform hover:scale-105"
                >
                    <Image 
                        src={yelpLogo} 
                        alt="Yelp reviews for HRZ Wheel Repair - 4.9 stars rating" 
                        title="See our verified Yelp reviews - Top-rated wheel repair in Los Angeles"
                        class="w-5 h-5 brightness-0 invert"
                        width={20}
                        height={20}
                    />
                    <span>See Us on Yelp</span>
                </a>
            </div>
        </div>

        <!-- Testimonials Slider -->
        <div class="relative max-w-7xl mx-auto">
            <!-- Slider Container -->
            <div class="overflow-hidden">
                <div id="testimonials-track" class="flex transition-transform duration-500 ease-out" style="will-change: transform;">
                    {testimonials.map((testimonial, index) => (
                        <div class="w-full md:w-1/2 lg:w-1/3 flex-shrink-0 px-4">
                            <div class="group relative p-1 rounded-2xl bg-gradient-to-b from-white/10 to-white/5 hover:from-gold-500/30 hover:to-gold-600/30 transition-all duration-500 h-full">
                                <div class="absolute inset-0 bg-zinc-950 rounded-2xl m-[1px]"></div>
                                <div class="relative p-8 h-full flex flex-col">
                                    <!-- Stars -->
                                    <div class="flex gap-1 mb-4">
                                        {Array.from({ length: testimonial.rating }).map(() => (
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 text-gold-500">
                                                <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.433 2.082-5.006z" clip-rule="evenodd" />
                                            </svg>
                                        ))}
                                    </div>

                                    <!-- Review Text -->
                                    <p class="text-gray-300 leading-relaxed mb-6 flex-grow text-sm">
                                        "{testimonial.text}"
                                    </p>

                                    <!-- Author Info -->
                                    <div class="flex items-center gap-4 pt-4 border-t border-white/10">
                                        <!-- Avatar -->
                                        <Image 
                                            src={testimonial.avatar} 
                                            alt={`${testimonial.name} - Verified customer review for HRZ Wheel Repair in ${testimonial.location}`}
                                            title={`Customer testimonial from ${testimonial.name} - ${testimonial.location}`}
                                            class="w-12 h-12 rounded-full object-cover shrink-0"
                                            width={48}
                                            height={48}
                                        />
                                        <div class="flex-grow min-w-0">
                                            <p class="text-white font-bold text-sm">{testimonial.name}</p>
                                            <p class="text-gray-300 text-xs truncate">{testimonial.location}</p>
                                        </div>
                                        <span class="text-gray-400 text-xs shrink-0">{testimonial.date}</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>

            <!-- Navigation Buttons -->
            <button 
                id="prev-btn"
                class="absolute left-0 top-1/2 -translate-y-1/2 -translate-x-4 w-12 h-12 rounded-full bg-zinc-900 border border-white/10 hover:border-gold-500/50 hover:bg-gold-500/10 transition-all duration-300 flex items-center justify-center group"
                aria-label="Previous testimonials"
            >
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6 text-white group-hover:text-gold-400">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
                </svg>
            </button>
            <button 
                id="next-btn"
                class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-4 w-12 h-12 rounded-full bg-zinc-900 border border-white/10 hover:border-gold-500/50 hover:bg-gold-500/10 transition-all duration-300 flex items-center justify-center group"
                aria-label="Next testimonials"
            >
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6 text-white group-hover:text-gold-400">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                </svg>
            </button>

            <!-- Dots Indicator -->
            <div class="flex justify-center items-center gap-1 mt-8" id="dots-container">
                <!-- Dots will be generated by JS -->
            </div>
        </div>
    </div>
</section>

<script>
    const track = document.getElementById('testimonials-track');
    const prevBtn = document.getElementById('prev-btn');
    const nextBtn = document.getElementById('next-btn');
    const dotsContainer = document.getElementById('dots-container');
    
    let currentIndex = 0;
    const totalSlides = 9; // Total number of testimonials
    let slidesPerView = window.innerWidth >= 1024 ? 3 : window.innerWidth >= 768 ? 2 : 1;
    let maxIndex = Math.max(0, totalSlides - slidesPerView);
    
    function initDots() {
        if (!dotsContainer) return;
        dotsContainer.innerHTML = '';
        for (let i = 0; i <= maxIndex; i++) {
            // Create wrapper button for larger touch target
            const button = document.createElement('button');
            button.className = 'group flex items-center justify-center focus:outline-none p-1';
            button.ariaLabel = `Go to slide ${i + 1}`;
            button.onclick = () => goToSlide(i);
            
            // Create visual dot
            const dot = document.createElement('span');
            // Base classes
            let dotClasses = 'block rounded-full transition-all duration-300 ';
            // Active/Inactive state
            if (i === currentIndex) {
                dotClasses += 'bg-gold-500 w-10 h-3';
            } else {
                dotClasses += 'bg-white/30 w-3 h-3 group-hover:bg-white/50';
            }
            dot.className = dotClasses;
            
            button.appendChild(dot);
            dotsContainer.appendChild(button);
        }
    }
    
    function updateSlider() {
        if (track) {
            // On mobile (1 slide), we move 100% per slide.
            // On tablet (2 slides), we move 50% per slide.
            // On desktop (3 slides), we move 33.33% per slide.
            
            const percentage = (100 / slidesPerView) * currentIndex;
            track.style.transform = `translateX(-${percentage}%)`;
            
            // Update dots
            const buttons = dotsContainer?.children;
            if (buttons) {
                Array.from(buttons).forEach((button, i) => {
                    const dot = button.querySelector('span');
                    if (dot) {
                        if (i === currentIndex) {
                            dot.className = 'block rounded-full transition-all duration-300 bg-gold-500 w-10 h-3';
                        } else {
                            dot.className = 'block rounded-full transition-all duration-300 bg-white/30 w-3 h-3 group-hover:bg-white/50';
                        }
                    }
                });
            }
        }
    }
    
    function goToSlide(index: number) {
        currentIndex = Math.max(0, Math.min(index, maxIndex));
        updateSlider();
    }
    
    function handleResize() {
        const newSlidesPerView = window.innerWidth >= 1024 ? 3 : window.innerWidth >= 768 ? 2 : 1;
        if (newSlidesPerView !== slidesPerView) {
            slidesPerView = newSlidesPerView;
            maxIndex = Math.max(0, totalSlides - slidesPerView);
            // Adjust current index if out of bounds
            if (currentIndex > maxIndex) {
                currentIndex = maxIndex;
            }
            initDots();
            updateSlider();
        }
    }

    window.addEventListener('resize', handleResize);
    
    prevBtn?.addEventListener('click', () => {
        goToSlide(currentIndex - 1);
    });
    
    nextBtn?.addEventListener('click', () => {
        goToSlide(currentIndex + 1);
    });
    
    // Initialize
    initDots();

    // Auto-play (optional)
    setInterval(() => {
        goToSlide(currentIndex >= maxIndex ? 0 : currentIndex + 1);
    }, 5000);
</script>


<style>
    @keyframes pulse-slow {
        0%,
        100% {
            opacity: 0.75;
        }
        50% {
            opacity: 1;
        }
    }

    .animate-pulse-slow {
        animation: pulse-slow 4s ease-in-out infinite;
    }
</style>


