---
// Contact.astro
---

<script src="https://www.google.com/recaptcha/api.js?render=6LeYgRksAAAAAHErCOzcR0Ydr_ZUx_8pny0KTQVQ"></script>

---

<section
    class="relative min-h-screen flex items-center justify-center py-24 lg:py-32 bg-zinc-950 overflow-hidden"
>
    <!-- Background Effects -->
    <div class="absolute inset-0 pointer-events-none">
        <div
            class="absolute top-0 left-1/4 w-96 h-96 bg-gold-500/10 rounded-full blur-[100px]"
        >
        </div>
        <div
            class="absolute bottom-0 right-1/4 w-96 h-96 bg-bmw-blue/10 rounded-full blur-[100px]"
        >
        </div>
    </div>

    <div class="container mx-auto px-6 relative z-10">
        <div class="max-w-3xl mx-auto">
            <!-- Section Header -->
            <div class="text-center mb-12">
                <h1
                    class="text-4xl md:text-6xl font-display font-bold text-white mb-6"
                >
                    Get a Free <span
                        class="text-transparent bg-clip-text bg-gradient-to-r from-gold-400 to-white"
                        >Quote</span
                    >
                </h1>
                <p class="text-gray-400 text-lg md:text-xl leading-relaxed">
                    Ready to restore your wheels in Los Angeles or Orange
                    County? Fill out the form below for a quick quote or call us
                    now at (626) 863-2885 for same-day service.
                </p>
            </div>

            <!-- Contact Form Card -->
            <div
                class="bg-zinc-900/80 backdrop-blur-xl border border-white/10 rounded-3xl p-8 md:p-10 shadow-2xl"
            >
                <form id="contact-form" class="space-y-6">
                    <!-- Web3Forms Access Key -->
                    <input
                        type="hidden"
                        name="access_key"
                        value="1cd741bb-5111-4d74-ba99-a1af6d5e03ba"
                    />
                    <input
                        type="hidden"
                        name="subject"
                        value="New Quote Request - HRZ Wheels"
                    />
                    <input
                        type="hidden"
                        name="from_name"
                        value="HRZ Wheels Website"
                    />

                    <!-- Name & Phone -->
                    <div class="grid md:grid-cols-2 gap-6">
                        <div class="space-y-2">
                            <label
                                for="name"
                                class="block text-sm font-bold text-gold-500 uppercase tracking-wider"
                                >Name</label
                            >
                            <input
                                type="text"
                                id="name"
                                name="name"
                                required
                                class="w-full bg-black/50 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-gray-600 focus:border-gold-500 focus:ring-1 focus:ring-gold-500 outline-none transition-all"
                                placeholder="Your Name"
                            />
                        </div>
                        <div class="space-y-2">
                            <label
                                for="phone"
                                class="block text-sm font-bold text-gold-500 uppercase tracking-wider"
                                >Phone</label
                            >
                            <input
                                type="tel"
                                id="phone"
                                name="phone"
                                required
                                class="w-full bg-black/50 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-gray-600 focus:border-gold-500 focus:ring-1 focus:ring-gold-500 outline-none transition-all"
                                placeholder="(555) 123-4567"
                            />
                        </div>
                    </div>

                    <!-- Email -->
                    <div class="space-y-2">
                        <label
                            for="email"
                            class="block text-sm font-bold text-gold-500 uppercase tracking-wider"
                            >Email</label
                        >
                        <input
                            type="email"
                            id="email"
                            name="email"
                            required
                            class="w-full bg-black/50 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-gray-600 focus:border-gold-500 focus:ring-1 focus:ring-gold-500 outline-none transition-all"
                            placeholder="you@example.com"
                        />
                    </div>

                    <!-- Service -->
                    <div class="space-y-2">
                        <label
                            for="service"
                            class="block text-sm font-bold text-gold-500 uppercase tracking-wider"
                            >Service Required</label
                        >

                        <!-- Hidden input for form submission -->
                        <input
                            type="hidden"
                            id="service"
                            name="service"
                            required
                        />

                        <!-- Custom Dropdown -->
                        <div class="relative custom-dropdown">
                            <button
                                type="button"
                                class="custom-dropdown-toggle w-full bg-zinc-900/90 border border-white/10 rounded-xl px-4 py-3.5 text-left text-white focus:border-gold-500 focus:ring-2 focus:ring-gold-500/30 outline-none transition-all cursor-pointer hover:border-gold-500/50 flex justify-between items-center"
                                data-dropdown="service"
                            >
                                <span class="dropdown-text text-gray-400"
                                    >Select a Service...</span
                                >
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke-width="2.5"
                                    stroke="currentColor"
                                    class="w-5 h-5 text-gold-500 transition-transform duration-200 dropdown-arrow"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path>
                                </svg>
                            </button>

                            <!-- Dropdown Menu -->
                            <div
                                class="dropdown-menu absolute w-full mt-2 bg-zinc-900 border border-white/10 rounded-xl shadow-2xl overflow-hidden z-50 hidden"
                            >
                                <div
                                    class="dropdown-option px-4 py-3.5 text-white hover:bg-zinc-800 cursor-pointer transition-colors border-b border-white/5"
                                    data-value="CURB RASH"
                                >
                                    <div
                                        class="flex items-center justify-between"
                                    >
                                        <span
                                            >CURB RASH - $125 (per wheel) 1Hr</span
                                        >
                                        <svg
                                            class="checkmark w-5 h-5 text-gold-500 hidden"
                                            xmlns="http://www.w3.org/2000/svg"
                                            viewBox="0 0 24 24"
                                            fill="currentColor"
                                        >
                                            <path
                                                fill-rule="evenodd"
                                                d="M19.916 4.626a.75.75 0 01.208 1.04l-9 13.5a.75.75 0 01-1.154.114l-6-6a.75.75 0 011.06-1.06l5.353 5.353 8.493-12.739a.75.75 0 011.04-.208z"
                                                clip-rule="evenodd"></path>
                                        </svg>
                                    </div>
                                </div>
                                <div
                                    class="dropdown-option px-4 py-3.5 text-white hover:bg-zinc-800 cursor-pointer transition-colors"
                                    data-value="BUMPER SPOT PAINT REPAIR"
                                >
                                    <div
                                        class="flex items-center justify-between"
                                    >
                                        <span
                                            >BUMPER SPOT PAINT REPAIR - $395
                                            3Hrs</span
                                        >
                                        <svg
                                            class="checkmark w-5 h-5 text-gold-500 hidden"
                                            xmlns="http://www.w3.org/2000/svg"
                                            viewBox="0 0 24 24"
                                            fill="currentColor"
                                        >
                                            <path
                                                fill-rule="evenodd"
                                                d="M19.916 4.626a.75.75 0 01.208 1.04l-9 13.5a.75.75 0 01-1.154.114l-6-6a.75.75 0 011.06-1.06l5.353 5.353 8.493-12.739a.75.75 0 011.04-.208z"
                                                clip-rule="evenodd"></path>
                                        </svg>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Vehicle Details -->
                    <div class="grid md:grid-cols-3 gap-6">
                        <div class="space-y-2">
                            <label
                                for="carModel"
                                class="block text-sm font-bold text-gold-500 uppercase tracking-wider"
                                >Car Model</label
                            >
                            <input
                                type="text"
                                id="carModel"
                                name="carModel"
                                required
                                class="w-full bg-black/50 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-gray-600 focus:border-gold-500 focus:ring-1 focus:ring-gold-500 outline-none transition-all"
                                placeholder="e.g. Tesla Model 3"
                            />
                        </div>
                        <div class="space-y-2">
                            <label
                                for="year"
                                class="block text-sm font-bold text-gold-500 uppercase tracking-wider"
                                >Year</label
                            >
                            <input
                                type="text"
                                id="year"
                                name="year"
                                required
                                class="w-full bg-black/50 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-gray-600 focus:border-gold-500 focus:ring-1 focus:ring-gold-500 outline-none transition-all"
                                placeholder="e.g. 2022"
                            />
                        </div>
                        <div class="space-y-2">
                            <label
                                for="address"
                                class="block text-sm font-bold text-gold-500 uppercase tracking-wider"
                                >Address</label
                            >
                            <input
                                type="text"
                                id="address"
                                name="address"
                                required
                                class="w-full bg-black/50 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-gray-600 focus:border-gold-500 focus:ring-1 focus:ring-gold-500 outline-none transition-all"
                                placeholder="e.g. 123 Main St, Los Angeles, CA"
                            />
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="space-y-2">
                        <label
                            for="description"
                            class="block text-sm font-bold text-gold-500 uppercase tracking-wider"
                            >Description</label
                        >
                        <textarea
                            id="description"
                            name="description"
                            required
                            rows="4"
                            class="w-full bg-black/50 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-gray-600 focus:border-gold-500 focus:ring-1 focus:ring-gold-500 outline-none transition-all resize-none"
                            placeholder="Please describe the damage..."
                        ></textarea>
                    </div>

                    <!-- Photos -->
                    <div class="space-y-2">
                        <label
                            for="photos"
                            class="block text-sm font-bold text-gold-500 uppercase tracking-wider"
                            >Photos (Max 10, Max 5MB each)</label
                        >
                        <div class="relative">
                            <input
                                type="file"
                                id="photos"
                                name="photos"
                                multiple
                                accept="image/*"
                                required
                                class="hidden"
                            />
                            <label
                                for="photos"
                                class="flex items-center justify-center w-full bg-black/50 border border-dashed border-white/20 rounded-xl px-4 py-8 text-gray-400 cursor-pointer hover:border-gold-500 hover:text-gold-500 transition-all group"
                            >
                                <div class="text-center space-y-2">
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke-width="1.5"
                                        stroke="currentColor"
                                        class="w-8 h-8 mx-auto group-hover:scale-110 transition-transform"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"
                                        ></path>
                                    </svg>
                                    <span class="text-sm font-medium"
                                        >Click to upload photos</span
                                    >
                                </div>
                            </label>
                        </div>

                        <!-- Image Previews -->
                        <div
                            id="image-previews"
                            class="grid grid-cols-2 md:grid-cols-3 gap-4 mt-4 hidden"
                        >
                            <!-- Previews will be injected here -->
                        </div>

                        <p class="text-xs text-gray-400">
                            Images will be automatically compressed.
                        </p>
                    </div>

                    <!-- Submit Button -->
                    <button
                        type="submit"
                        class="w-full bg-gold-500 hover:bg-gold-400 text-black font-bold py-4 rounded-xl shadow-lg shadow-gold-500/20 transition-all transform hover:scale-[1.02] uppercase tracking-widest"
                    >
                        Send Request
                    </button>

                    <!-- Status Message -->
                    <div
                        id="form-status"
                        class="hidden text-center p-4 rounded-xl text-sm font-medium"
                    >
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

<style>
    /* Custom Dropdown Styles */
    .custom-dropdown {
        position: relative;
    }

    .dropdown-menu {
        animation: slideDown 0.2s ease-out;
        max-height: 300px;
        overflow-y: auto;
    }

    @keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .dropdown-option.selected {
        background: linear-gradient(135deg, #eab308 0%, #f59e0b 100%);
        color: #000;
        font-weight: 600;
    }

    .dropdown-option.selected .checkmark {
        display: block !important;
    }

    .dropdown-arrow.rotate {
        transform: rotate(180deg);
    }

    /* Scrollbar styling for dropdown */
    .dropdown-menu::-webkit-scrollbar {
        width: 6px;
    }

    .dropdown-menu::-webkit-scrollbar-track {
        background: #27272a;
        border-radius: 10px;
    }

    .dropdown-menu::-webkit-scrollbar-thumb {
        background: #eab308;
        border-radius: 10px;
    }
</style>

<script>
    // Custom Dropdown Functionality
    const dropdownToggle = document.querySelector(".custom-dropdown-toggle");
    const dropdownMenu = document.querySelector(".dropdown-menu");
    const dropdownOptions = document.querySelectorAll(".dropdown-option");
    const dropdownText = document.querySelector(".dropdown-text");
    const dropdownArrow = document.querySelector(".dropdown-arrow");
    const serviceInput = document.getElementById("service");

    // Toggle dropdown
    dropdownToggle?.addEventListener("click", () => {
        dropdownMenu.classList.toggle("hidden");
        dropdownArrow.classList.toggle("rotate");
    });

    // Select option
    dropdownOptions.forEach((option) => {
        option.addEventListener("click", () => {
            const value = option.getAttribute("data-value");
            const text = option.querySelector("span")?.textContent;

            // Update hidden input
            if (value) {
                serviceInput.value = value;
            }

            // Update displayed text
            if (text) {
                dropdownText.textContent = text;
                dropdownText.classList.remove("text-gray-400");
                dropdownText.classList.add("text-white");
            }

            // Update selection state
            dropdownOptions.forEach((opt) => opt.classList.remove("selected"));
            option.classList.add("selected");

            // Close dropdown
            dropdownMenu.classList.add("hidden");
            dropdownArrow.classList.remove("rotate");
        });
    });

    // Close dropdown when clicking outside
    document.addEventListener("click", (e) => {
        const target = e.target;
        if (!target.closest(".custom-dropdown")) {
            dropdownMenu?.classList.add("hidden");
            dropdownArrow?.classList.remove("rotate");
        }
    });

    const form = document.getElementById("contact-form");
    const statusDiv = document.getElementById("form-status");
    const fileInput = document.getElementById("photos");
    const previewContainer = document.getElementById("image-previews");
    let selectedFiles = [];

    // Handle file selection
    fileInput?.addEventListener("change", (e) => {
        const files = Array.from(e.target.files);

        // Add new files to selection (respecting limit)
        const remainingSlots = 10 - selectedFiles.length;
        const filesToAdd = files.slice(0, remainingSlots);

        if (files.length > remainingSlots) {
            alert(`You can only upload a maximum of 10 photos.`);
        }

        selectedFiles = [...selectedFiles, ...filesToAdd];
        updatePreviews();

        // Reset input so same file can be selected again if removed
        fileInput.value = "";
    });

    function updatePreviews() {
        previewContainer.innerHTML = "";

        if (selectedFiles.length > 0) {
            previewContainer.classList.remove("hidden");
        } else {
            previewContainer.classList.add("hidden");
        }

        selectedFiles.forEach((file, index) => {
            const reader = new FileReader();
            reader.onload = (e) => {
                const div = document.createElement("div");
                div.className =
                    "relative group aspect-square bg-zinc-800 rounded-xl overflow-hidden border border-white/10";
                div.innerHTML = `
                    <img src="${e.target.result}" class="w-full h-full object-cover" alt="Preview">
                    <button type="button" onclick="removeFile(${index})" class="absolute top-2 right-2 bg-red-500 text-white p-1 rounded-full shadow-lg opacity-0 group-hover:opacity-100 transition-opacity hover:bg-red-600">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
                            <path d="M6.28 5.22a.75.75 0 00-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 101.06 1.06L10 11.06l3.72 3.72a.75.75 0 101.06 1.06L11.06 10l3.72-3.72a.75.75 0 00-1.06-1.06L10 8.94 6.28 5.22z" />
                        </svg>
                    </button>
                    <div class="absolute bottom-0 left-0 right-0 bg-black/60 p-2 text-xs text-white truncate">
                        ${file.name}
                    </div>
                `;
                previewContainer.appendChild(div);
            };
            reader.readAsDataURL(file);
        });
    }

    // Expose removeFile to global scope
    window.removeFile = (index) => {
        selectedFiles = selectedFiles.filter((_, i) => i !== index);
        updatePreviews();
    };

    form?.addEventListener("submit", async (e) => {
        e.preventDefault();

        if (!statusDiv) return;

        const submitBtn = form.querySelector('button[type="submit"]');
        const originalBtnText = submitBtn.innerText;

        // Loading state
        submitBtn.disabled = true;
        submitBtn.innerText = "SENDING...";
        statusDiv.classList.add("hidden");

        // Get reCAPTCHA token
        let recaptchaToken;
        try {
            recaptchaToken = await grecaptcha.execute('6LeYgRksAAAAAHErCOzcR0Ydr_ZUx_8pny0KTQVQ', { action: 'submit' });
        } catch (error) {
            console.error('reCAPTCHA error:', error);
            statusDiv.textContent = 'Security verification failed. Please try again.';
            statusDiv.classList.remove("hidden", "bg-green-500/20", "text-green-400");
            statusDiv.classList.add("bg-red-500/20", "text-red-400", "border", "border-red-500/30");
            submitBtn.disabled = false;
            submitBtn.innerText = originalBtnText;
            return;
        }

        const formData = new FormData(form);
        const object = Object.fromEntries(formData);

        // Handle file uploads
        let attachments = [];

        try {
            if (selectedFiles.length > 0) {
                statusDiv.textContent = "Processing images...";
                statusDiv.classList.remove("hidden");
                attachments = await processImages(selectedFiles);
            }
        } catch (error) {
            console.error(error);
            statusDiv.textContent = error.message;
            statusDiv.classList.remove(
                "hidden",
                "bg-green-500/20",
                "text-green-400",
            );
            statusDiv.classList.add(
                "bg-red-500/20",
                "text-red-400",
                "border",
                "border-red-500/30",
            );
            submitBtn.disabled = false;
            submitBtn.innerText = originalBtnText;
            return;
        }

        const json = JSON.stringify({ ...object, attachments, recaptchaToken });

        try {
            // Enviar a nuestra función de Cloudflare Workers
            const response = await fetch("/send-email", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                },
                body: json,
            });

            const contentType = response.headers.get("content-type");
            if (!contentType || !contentType.includes("application/json")) {
                const text = await response.text();
                console.error("Non-JSON response:", text);
                throw new Error(
                    "Server returned an error (not JSON). Check console for details.",
                );
            }

            const result = await response.json();
            console.log("Server response:", result);

            if (response.ok) {
                statusDiv.textContent =
                    "Message sent successfully! We will be in touch soon.";
                statusDiv.classList.remove(
                    "hidden",
                    "bg-red-500/20",
                    "text-red-400",
                );
                statusDiv.classList.add(
                    "bg-green-500/20",
                    "text-green-400",
                    "border",
                    "border-green-500/30",
                );
                form.reset();
                selectedFiles = [];
                updatePreviews();

                // Reset dropdown
                dropdownText.textContent = "Select a Service...";
                dropdownText.classList.remove("text-white");
                dropdownText.classList.add("text-gray-400");
                dropdownOptions.forEach((opt) =>
                    opt.classList.remove("selected"),
                );
            } else {
                throw new Error(result.message || "Failed to send");
            }
        } catch (error) {
            console.error(error);
            statusDiv.textContent =
                "Something went wrong. Please try again or call us directly.";
            statusDiv.classList.remove(
                "hidden",
                "bg-green-500/20",
                "text-green-400",
            );
            statusDiv.classList.add(
                "bg-red-500/20",
                "text-red-400",
                "border",
                "border-red-500/30",
            );
        } finally {
            submitBtn.disabled = false;
            submitBtn.innerText = originalBtnText;
        }
    });

    // Image Compression Logic
    async function processImages(files) {
        const processedImages = [];
        const MAX_WIDTH = 1920;
        const MAX_HEIGHT = 1920;
        const MAX_SIZE_MB = 5;
        const MAX_FILES = 10;

        if (files.length > MAX_FILES) {
            throw new Error(
                `You can only upload a maximum of ${MAX_FILES} photos.`,
            );
        }

        for (const file of files) {
            if (file.size > MAX_SIZE_MB * 1024 * 1024) {
                throw new Error(
                    `File ${file.name} is too large. Max size is ${MAX_SIZE_MB}MB.`,
                );
            }

            try {
                const compressedBase64 = await compressImage(
                    file,
                    MAX_WIDTH,
                    MAX_HEIGHT,
                );
                processedImages.push({
                    filename: file.name.replace(/\.[^/.]+$/, "") + ".webp",
                    content: compressedBase64.split(",")[1], // Remove data:image/webp;base64, prefix
                });
            } catch (err) {
                console.error("Error processing image:", err);
                throw new Error(`Failed to process image ${file.name}`);
            }
        }
        return processedImages;
    }

    function compressImage(file, maxWidth, maxHeight) {
        return new Promise((resolve, reject) => {
            const reader = new FileReader();
            reader.readAsDataURL(file);
            reader.onload = (event) => {
                const img = new Image();
                img.src = event.target.result;
                img.onload = () => {
                    let width = img.width;
                    let height = img.height;

                    if (width > maxWidth || height > maxHeight) {
                        if (width > height) {
                            height = Math.round((height * maxWidth) / width);
                            width = maxWidth;
                        } else {
                            width = Math.round((width * maxHeight) / height);
                            height = maxHeight;
                        }
                    }

                    const canvas = document.createElement("canvas");
                    canvas.width = width;
                    canvas.height = height;
                    const ctx = canvas.getContext("2d");
                    ctx.drawImage(img, 0, 0, width, height);

                    // Compress to WebP with 0.6 quality
                    resolve(canvas.toDataURL("image/webp", 0.6));
                };
                img.onerror = (err) => reject(err);
            };
            reader.onerror = (err) => reject(err);
        });
    }
</script>
