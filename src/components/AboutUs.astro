---
// No imports needed for external GIF
---

<section
    id="about"
    class="py-16 md:py-12 lg:py-32 bg-zinc-950 relative overflow-hidden"
>
    <!-- Enhanced Background Decoration with Multiple Layers -->
    <div class="absolute inset-0 pointer-events-none">
        <!-- Primary Golden Glow - Top Right -->
        <div
            class="absolute top-1/4 -right-32 w-[500px] h-[500px] bg-gold-500/15 rounded-full blur-[100px] animate-pulse-slow"
        >
        </div>

        <!-- Secondary Golden Accent -->
        <div
            class="absolute top-1/2 right-1/4 w-64 h-64 bg-gold-400/10 rounded-full blur-3xl"
        >
        </div>

        <!-- Primary Blue Glow - Bottom Left -->
        <div
            class="absolute bottom-1/4 -left-32 w-96 h-96 bg-bmw-blue/15 rounded-full blur-[100px] animate-pulse-slow"
            style="animation-delay: 1s;"
        >
        </div>

        <!-- Accent Blue Glow -->
        <div
            class="absolute top-1/3 left-1/4 w-48 h-48 bg-bmw-blue/8 rounded-full blur-3xl"
        >
        </div>

        <!-- Subtle Grid Pattern Overlay -->
        <div
            class="absolute inset-0 opacity-[0.02]"
            style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 50px 50px;"
        >
        </div>
    </div>

    <div class="container mx-auto px-6 relative z-10">
        <div class="grid lg:grid-cols-2 gap-8 lg:gap-20 items-center">
            <!-- Left Column: Image -->
            <div class="relative group mt-8 lg:mt-0 order-last lg:order-first">
                <!-- Enhanced Decorative Frame with Animation -->
                <div
                    class="absolute -inset-6 bg-gradient-to-br from-gold-500/25 via-gold-400/15 to-bmw-blue/25 rounded-3xl blur-3xl opacity-75 group-hover:opacity-100 transition-opacity duration-500"
                >
                </div>

                <!-- Main Image Container -->
                <div
                    class="relative rounded-2xl overflow-hidden shadow-2xl border border-white/20 backdrop-blur-sm group-hover:border-gold-500/30 transition-all duration-500"
                >
                    <!-- Wheel Repair Animation Video -->
                    <div
                        class="aspect-[4/3] bg-gradient-to-br from-zinc-900 via-zinc-800 to-black relative"
                    >
                        <video
                            src="https://i.imgur.com/s0uQsgv.mp4"
                            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                            autoplay
                            loop
                            muted
                            playsinline
                            preload="none"
                            aria-label="Premium wheel repair process Los Angeles - Expert alloy rim refinishing service"
                            title="Luxury Vehicle Wheel Repair - Mobile Service in LA & Orange County"
                        ></video>

                        <!-- Enhanced Gradient Overlay -->
                        <div
                            class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"
                        >
                        </div>

                        <!-- Shimmer Effect on Hover -->
                        <div
                            class="absolute inset-0 bg-gradient-to-r from-transparent via-white/5 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-1000"
                        >
                        </div>
                    </div>

                    <!-- Enhanced Image Caption with Glassmorphism -->
                    <div
                        class="absolute bottom-0 left-0 right-0 p-6 bg-gradient-to-t from-black/95 via-black/80 to-transparent backdrop-blur-md"
                    >
                        <p
                            class="text-white font-medium text-sm tracking-wide flex items-center gap-2"
                        >
                            <span
                                class="w-2 h-2 bg-gold-500 rounded-full animate-pulse shadow-lg shadow-gold-500/50"
                            ></span>
                            Expert craftsmanship on every wheel
                        </p>
                    </div>
                </div>

                <!-- Enhanced Floating Badge with Glow -->
                <div
                    class="absolute -top-6 -left-4 md:-top-8 md:-left-8 bg-gradient-to-br from-gold-400 via-gold-500 to-gold-600 rounded-full p-6 md:p-8 shadow-2xl shadow-gold-500/40 border-4 border-zinc-950 group-hover:scale-110 transition-transform duration-500 scale-90 md:scale-100"
                >
                    <div class="text-center">
                        <p class="text-black font-bold text-2xl md:text-3xl">
                            8+
                        </p>
                        <p
                            class="text-black text-[10px] md:text-xs uppercase tracking-widest font-bold"
                        >
                            Years
                        </p>
                    </div>
                    <!-- Rotating Ring Effect -->
                    <div
                        class="absolute inset-0 rounded-full border-2 border-gold-300/30 animate-spin-slow"
                    >
                    </div>
                </div>

                <!-- Corner Accent Decorations -->
                <div
                    class="absolute -bottom-4 -right-4 w-24 h-24 border-r-2 border-b-2 border-gold-500/20 rounded-br-3xl"
                >
                </div>
            </div>

            <!-- Right Column: Content -->
            <div class="space-y-6 lg:space-y-10">
                <!-- Main Title with Enhanced Gradient -->
                <div>
                    <h2
                        class="text-4xl md:text-5xl lg:text-6xl font-display font-bold text-white leading-tight"
                    >
                        Servicing Cars for <br />
                        <span
                            class="text-transparent bg-clip-text bg-gradient-to-r from-gold-400 to-white"
                        >
                            Over 8 Years
                        </span>
                    </h2>
                    <div class="flex items-center gap-3 mt-6">
                        <div
                            class="w-24 h-1 bg-gradient-to-r from-gold-500 to-gold-400 rounded-full"
                        >
                        </div>
                        <div class="w-2 h-2 bg-gold-500 rounded-full"></div>
                        <div class="w-2 h-2 bg-bmw-blue rounded-full"></div>
                    </div>
                </div>

                <!-- Enhanced Description with Better Spacing -->
                <div class="space-y-6">
                    <p
                        class="text-gray-300 text-base md:text-lg leading-relaxed"
                    >
                        HRZ Wheel Repair delivers expert mobile wheel repair
                        throughout Los Angeles and Orange County with precision
                        and speed. In as fast as <strong
                            class="text-white font-bold bg-gradient-to-r from-gold-500/10 to-transparent px-2 py-0.5 rounded"
                            >30 minutes</strong
                        >, we can match your rim's original colors perfectly and
                        get you back on the road with confidence.
                    </p>

                    <p
                        class="text-gray-300 text-base md:text-lg leading-relaxed"
                    >
                        Our commitment is simple: fast, professional wheel
                        repair service with exceptional results. We take pride
                        in identifying the best repair method for each wheel
                        type, ensuring quality that exceeds expectations every
                        time. Specializing in luxury vehicles including Tesla,
                        BMW, Mercedes, and more.
                    </p>
                </div>

                <!-- Feature Highlights -->
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div
                        class="text-center p-4 rounded-xl bg-white/5 backdrop-blur-sm border border-white/10 hover:border-gold-500/30 transition-all duration-300 group flex flex-row sm:flex-col items-center justify-between sm:justify-center gap-4 sm:gap-0"
                    >
                        <p
                            class="text-2xl font-bold text-gold-400 group-hover:scale-110 transition-transform duration-300"
                        >
                            30min
                        </p>
                        <p
                            class="text-xs text-gray-400 mt-0 sm:mt-1 uppercase tracking-wider"
                        >
                            Fast Service
                        </p>
                    </div>
                    <div
                        class="text-center p-4 rounded-xl bg-white/5 backdrop-blur-sm border border-white/10 hover:border-bmw-blue/30 transition-all duration-300 group flex flex-row sm:flex-col items-center justify-between sm:justify-center gap-4 sm:gap-0"
                    >
                        <p
                            class="text-2xl font-bold text-bmw-blue group-hover:scale-110 transition-transform duration-300"
                        >
                            100%
                        </p>
                        <p
                            class="text-xs text-gray-400 mt-0 sm:mt-1 uppercase tracking-wider"
                        >
                            Color Match
                        </p>
                    </div>
                    <div
                        class="text-center p-4 rounded-xl bg-white/5 backdrop-blur-sm border border-white/10 hover:border-gold-500/30 transition-all duration-300 group flex flex-row sm:flex-col items-center justify-between sm:justify-center gap-4 sm:gap-0"
                    >
                        <p
                            class="text-2xl font-bold text-gold-400 group-hover:scale-110 transition-transform duration-300"
                        >
                            8+
                        </p>
                        <p
                            class="text-xs text-gray-400 mt-0 sm:mt-1 uppercase tracking-wider"
                        >
                            Years Exp
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    @keyframes pulse-slow {
        0%,
        100% {
            opacity: 0.75;
        }
        50% {
            opacity: 1;
        }
    }

    @keyframes spin-slow {
        from {
            transform: rotate(0deg);
        }
        to {
            transform: rotate(360deg);
        }
    }

    @keyframes gradient {
        0%,
        100% {
            background-position: 0% 50%;
        }
        50% {
            background-position: 100% 50%;
        }
    }

    .animate-pulse-slow {
        animation: pulse-slow 4s ease-in-out infinite;
    }

    .animate-spin-slow {
        animation: spin-slow 20s linear infinite;
    }

    .animate-gradient {
        background-size: 200% 200%;
        animation: gradient 3s ease infinite;
    }
</style>
