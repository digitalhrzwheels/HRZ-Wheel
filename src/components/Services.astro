---

---

<section
    id="services"
    class="py-16 md:py-12 lg:py-32 bg-zinc-950 relative overflow-hidden"
>
    <!-- Enhanced Background Decoration with Multiple Layers -->
    <div class="absolute inset-0 pointer-events-none">
        <!-- Primary Golden Glow - Top Right -->
        <div
            class="absolute top-1/4 -right-32 w-[500px] h-[500px] bg-gold-500/15 rounded-full blur-[100px] animate-pulse-slow"
        >
        </div>

        <!-- Secondary Golden Accent -->
        <div
            class="absolute top-1/2 right-1/4 w-64 h-64 bg-gold-400/10 rounded-full blur-3xl"
        >
        </div>

        <!-- Primary Blue Glow - Bottom Left -->
        <div
            class="absolute bottom-1/4 -left-32 w-96 h-96 bg-bmw-blue/15 rounded-full blur-[100px] animate-pulse-slow"
            style="animation-delay: 1s;"
        >
        </div>

        <!-- Accent Blue Glow -->
        <div
            class="absolute top-1/3 left-1/4 w-48 h-48 bg-bmw-blue/8 rounded-full blur-3xl"
        >
        </div>

        <!-- Subtle Grid Pattern Overlay -->
        <div
            class="absolute inset-0 opacity-[0.02]"
            style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 50px 50px;"
        >
        </div>
    </div>

    <div class="container mx-auto px-6 relative z-10">
        <!-- Section Header -->
        <div class="text-center mb-20">
            <h2
                class="text-4xl md:text-6xl font-display font-bold text-white mb-6 tracking-tight"
            >
                World-Class <span
                    class="text-transparent bg-clip-text bg-gradient-to-r from-gold-400 to-white"
                    >Wheel Restoration</span
                > Services
            </h2>
            <p class="text-gray-400 max-w-2xl mx-auto text-lg leading-relaxed">
                Serving Los Angeles & Orange County since 2017. Professional
                mobile alloy wheel repair with factory-grade precision and
                craftsmanship delivered directly to your home or office.
            </p>
        </div>

        <!-- Services Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            <!-- Service 1: Curb Rash -->
            <div
                class="group relative p-8 rounded-3xl bg-zinc-900/50 border border-white/10 hover:border-gold-500/50 transition-all duration-500 hover:shadow-2xl hover:shadow-gold-500/10 hover:-translate-y-2 overflow-hidden"
            >
                <div
                    class="absolute inset-0 bg-gradient-to-br from-gold-500/5 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"
                >
                </div>
                <div class="relative z-10">
                    <div
                        class="w-16 h-16 bg-zinc-950 rounded-2xl flex items-center justify-center mb-6 border border-white/10 group-hover:border-gold-500/50 group-hover:scale-110 transition-all duration-500 shadow-lg"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="1.5"
                            stroke="currentColor"
                            class="w-8 h-8 text-white group-hover:text-gold-400 transition-colors"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z"
                            ></path>
                        </svg>
                    </div>
                    <h3
                        class="text-2xl font-display font-bold text-white mb-3 group-hover:text-gold-400 transition-colors"
                    >
                        Alloy Wheel Repair
                    </h3>
                    <p class="text-gray-400 leading-relaxed">
                        Expert alloy wheel repair in Los Angeles & Orange
                        County. We specialize in curb rash repair, scratches,
                        and scuffs using precision sanding and color-matching to
                        restore your wheel's original factory finish perfectly.
                    </p>
                </div>
            </div>

            <!-- Service 2: Bumper Spot Repair -->
            <div
                class="group relative p-8 rounded-3xl bg-zinc-900/50 border border-white/10 hover:border-bmw-blue/50 transition-all duration-500 hover:shadow-2xl hover:shadow-bmw-blue/10 hover:-translate-y-2 overflow-hidden"
            >
                <div
                    class="absolute inset-0 bg-gradient-to-br from-bmw-blue/5 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"
                >
                </div>
                <div class="relative z-10">
                    <div
                        class="w-16 h-16 bg-zinc-950 rounded-2xl flex items-center justify-center mb-6 border border-white/10 group-hover:border-bmw-blue/50 group-hover:scale-110 transition-all duration-500 shadow-lg"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="1.5"
                            stroke="currentColor"
                            class="w-8 h-8 text-white group-hover:text-bmw-blue transition-colors"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M9.53 16.122a3 3 0 00-5.78 1.128 2.25 2.25 0 01-2.4 2.245 4.5 4.5 0 008.4-2.245c0-.399-.077-.78-.22-1.128zm0 0a15.998 15.998 0 003.388-1.62m-5.043-.025a15.994 15.994 0 011.622-3.395m3.42 3.42a15.995 15.995 0 004.764-4.648l3.876-5.814a1.151 1.151 0 00-1.597-1.597L14.146 6.32a15.996 15.996 0 00-4.649 4.763m3.42 3.42a6.776 6.776 0 00-3.42-3.42"
                            ></path>
                        </svg>
                    </div>
                    <h3
                        class="text-2xl font-display font-bold text-white mb-3 group-hover:text-bmw-blue transition-colors"
                    >
                        Bumper Spot Repair
                    </h3>
                    <p class="text-gray-400 leading-relaxed">
                        Professional bumper spot repair service in LA & Orange
                        County. Minor bumper scratches and scuffs? We expertly
                        repair and refinish damaged areas, restoring your
                        bumper's original appearance to factory condition.
                    </p>
                </div>
            </div>

            <!-- Service 3: Mobile Concierge -->
            <div
                class="group relative p-8 rounded-3xl bg-zinc-900/50 border border-white/10 hover:border-gold-500/50 transition-all duration-500 hover:shadow-2xl hover:shadow-gold-500/10 hover:-translate-y-2 overflow-hidden md:col-span-2 lg:col-span-1"
            >
                <div
                    class="absolute inset-0 bg-gradient-to-br from-gold-500/5 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"
                >
                </div>
                <div class="relative z-10">
                    <div
                        class="w-16 h-16 bg-zinc-950 rounded-2xl flex items-center justify-center mb-6 border border-white/10 group-hover:border-gold-500/50 group-hover:scale-110 transition-all duration-500 shadow-lg"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            class="w-8 h-8 text-white group-hover:text-gold-400 transition-colors"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"
                            ></path>
                        </svg>
                    </div>
                    <h3
                        class="text-2xl font-display font-bold text-white mb-3 group-hover:text-gold-400 transition-colors"
                    >
                        Mobile Concierge Service
                    </h3>
                    <p class="text-gray-400 leading-relaxed">
                        Premium mobile alloy wheel repair service - we bring the
                        shop to you anywhere in Los Angeles or Orange County.
                        Whether at home, work, or the dealership, our fully
                        equipped units provide white-glove service at your
                        convenience.
                    </p>
                </div>
            </div>
        </div>

        <!-- Trust Signals / Stats -->
        <div class="mt-8 grid grid-cols-1 sm:grid-cols-4 gap-4">
            <div
                class="text-center p-4 rounded-xl bg-white/5 backdrop-blur-sm border border-white/10 hover:border-gold-500/30 transition-all duration-300 group flex flex-row sm:flex-col items-center justify-between sm:justify-center gap-4 sm:gap-0"
            >
                <p
                    class="text-2xl font-bold text-gold-400 group-hover:scale-110 transition-transform duration-300"
                >
                    8+
                </p>
                <p
                    class="text-xs text-gray-400 mt-0 sm:mt-1 uppercase tracking-wider"
                >
                    Years Experience
                </p>
            </div>
            <div
                class="text-center p-4 rounded-xl bg-white/5 backdrop-blur-sm border border-white/10 hover:border-bmw-blue/30 transition-all duration-300 group flex flex-row sm:flex-col items-center justify-between sm:justify-center gap-4 sm:gap-0"
            >
                <p
                    class="text-2xl font-bold text-bmw-blue group-hover:scale-110 transition-transform duration-300"
                >
                    5k+
                </p>
                <p
                    class="text-xs text-gray-400 mt-0 sm:mt-1 uppercase tracking-wider"
                >
                    Wheels Restored
                </p>
            </div>
            <div
                class="text-center p-4 rounded-xl bg-white/5 backdrop-blur-sm border border-white/10 hover:border-gold-500/30 transition-all duration-300 group flex flex-row sm:flex-col items-center justify-between sm:justify-center gap-4 sm:gap-0"
            >
                <p
                    class="text-2xl font-bold text-gold-400 group-hover:scale-110 transition-transform duration-300"
                >
                    100%
                </p>
                <p
                    class="text-xs text-gray-400 mt-0 sm:mt-1 uppercase tracking-wider"
                >
                    Satisfaction
                </p>
            </div>
            <div
                class="text-center p-4 rounded-xl bg-white/5 backdrop-blur-sm border border-white/10 hover:border-bmw-blue/30 transition-all duration-300 group flex flex-row sm:flex-col items-center justify-between sm:justify-center gap-4 sm:gap-0"
            >
                <p
                    class="text-2xl font-bold text-bmw-blue group-hover:scale-110 transition-transform duration-300"
                >
                    1 Year
                </p>
                <p
                    class="text-xs text-gray-400 mt-0 sm:mt-1 uppercase tracking-wider"
                >
                    Guarantee
                </p>
            </div>
        </div>
    </div>
</section>

<style>
    @keyframes pulse-slow {
        0%,
        100% {
            opacity: 0.75;
        }
        50% {
            opacity: 1;
        }
    }

    .animate-pulse-slow {
        animation: pulse-slow 4s ease-in-out infinite;
    }
</style>
