---
// HRZ Wheel Repair – Los Angeles Location Page
// URL: https://hrzwheel.com/wheel-repair-los-angeles
import Layout from '../layouts/Layout.astro';

const pageData = {
  title: 'Mobile Wheel Repair in Los Angeles | HRZ Wheel Repair',
  description:
    'Professional mobile wheel repair in Los Angeles — curb rash repair, cosmetic wheel repair, and alloy wheel restoration brought to your location. Same-day appointments available.',
  image: '/og-image.png',
};

// FAQ schema only — business schema is already in Layout.astro
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How does mobile wheel repair work in Los Angeles?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'We come to your home, office, or any location in the Los Angeles area. Our technician arrives with all the equipment needed to repair your wheels on-site — no need to leave your vehicle at a shop.',
      },
    },
    {
      '@type': 'Question',
      name: 'How long does curb rash repair take?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Most curb rash repairs take 30–60 minutes per wheel depending on the severity of the damage. We can typically complete all four wheels in a single visit.',
      },
    },
    {
      '@type': 'Question',
      name: 'What areas of Los Angeles do you serve?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'We serve Los Angeles and surrounding areas including Beverly Hills, Santa Monica, Culver City, West Hollywood, Glendale, Burbank, Pasadena, Inglewood, and Marina del Rey.',
      },
    },
  ],
};
---

<Layout title={pageData.title} description={pageData.description} image={pageData.image}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-gradient-to-br from-zinc-900 to-zinc-800 py-20 md:py-28">
    <div class="mx-auto max-w-4xl px-6 text-center">
      <h1 class="text-4xl font-bold tracking-tight text-white md:text-5xl">
        Mobile Wheel Repair in Los Angeles
      </h1>
      <p class="mt-4 text-lg text-zinc-300 md:text-xl">
        Professional cosmetic wheel repair and curb rash repair — delivered to your location
        anywhere in LA.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a
          href="/contact"
          class="rounded-lg bg-amber-500 px-8 py-3 text-base font-semibold text-black transition hover:bg-amber-400"
        >
          Get a Free Quote
        </a>
        <a
          href="tel:+16268632885"
          class="rounded-lg border border-zinc-600 px-8 py-3 text-base font-semibold text-white transition hover:border-zinc-400"
        >
          Call or Text Us
        </a>
      </div>
    </div>
  </section>

  <!-- Services Overview -->
  <section class="mx-auto max-w-5xl px-6 py-16">
    <h2 class="text-3xl font-bold text-zinc-900">Our Los Angeles Wheel Repair Services</h2>
    <p class="mt-4 text-lg text-zinc-600">
      We bring the repair shop to you. Whether you're dealing with curb damage, scuffed rims, or
      cosmetic wear, our mobile service covers all of Los Angeles.
    </p>

    <div class="mt-10 grid gap-8 md:grid-cols-3">
      <div class="rounded-xl border border-zinc-200 p-6">
        <h3 class="text-xl font-semibold text-zinc-900">Curb Rash Repair</h3>
        <p class="mt-2 text-zinc-600">
          Scraped or gouged your rim on a curb? We restore the damaged area, fill gouges, and
          refinish the wheel to match its original appearance — all at your location.
        </p>
      </div>
      <div class="rounded-xl border border-zinc-200 p-6">
        <h3 class="text-xl font-semibold text-zinc-900">Cosmetic Wheel Repair</h3>
        <p class="mt-2 text-zinc-600">
          Scuffs, scratches, paint chips, and clear coat peeling? Our cosmetic repair process
          brings back the factory finish without removing the wheel from your vehicle.
        </p>
      </div>
      <div class="rounded-xl border border-zinc-200 p-6">
        <h3 class="text-xl font-semibold text-zinc-900">Mobile Service</h3>
        <p class="mt-2 text-zinc-600">
          No shop visit required. We arrive at your home, office, or parking spot anywhere in Los
          Angeles with everything needed to complete the repair on-site.
        </p>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="bg-zinc-50 py-16">
    <div class="mx-auto max-w-4xl px-6">
      <h2 class="text-3xl font-bold text-zinc-900">How Our Mobile Service Works</h2>
      <ol class="mt-10 space-y-8">
        <li class="flex gap-6">
          <span class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-amber-500 text-xl font-bold text-black">1</span>
          <div>
            <h3 class="text-lg font-semibold text-zinc-900">Contact Us</h3>
            <p class="mt-1 text-zinc-600">
              Call, text, or fill out our contact form. Tell us about the damage and your Los
              Angeles location.
            </p>
          </div>
        </li>
        <li class="flex gap-6">
          <span class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-amber-500 text-xl font-bold text-black">2</span>
          <div>
            <h3 class="text-lg font-semibold text-zinc-900">Schedule a Visit</h3>
            <p class="mt-1 text-zinc-600">
              We'll set up a time that works for you. Same-day appointments are often available
              across the LA area.
            </p>
          </div>
        </li>
        <li class="flex gap-6">
          <span class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-amber-500 text-xl font-bold text-black">3</span>
          <div>
            <h3 class="text-lg font-semibold text-zinc-900">We Come to You</h3>
            <p class="mt-1 text-zinc-600">
              Our technician arrives with all tools and materials. Most repairs are completed in
              under an hour per wheel.
            </p>
          </div>
        </li>
        <li class="flex gap-6">
          <span class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-amber-500 text-xl font-bold text-black">4</span>
          <div>
            <h3 class="text-lg font-semibold text-zinc-900">Drive Away</h3>
            <p class="mt-1 text-zinc-600">
              Your wheels look like new. No waiting at a shop, no leaving your car behind.
            </p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- Service Areas -->
  <section class="mx-auto max-w-4xl px-6 py-16">
    <h2 class="text-3xl font-bold text-zinc-900">Areas We Serve in Los Angeles</h2>
    <p class="mt-4 text-lg text-zinc-600">
      Our mobile wheel repair covers the greater Los Angeles area, including:
    </p>
    <div class="mt-8 grid grid-cols-2 gap-4 md:grid-cols-3">
      {[
        'Los Angeles',
        'Beverly Hills',
        'Santa Monica',
        'Culver City',
        'West Hollywood',
        'Glendale',
        'Burbank',
        'Pasadena',
        'Inglewood',
        'Marina del Rey',
        'Venice',
        'Century City',
        'Encino',
        'Tarzana',
        'Woodland Hills',
        'Sherman Oaks',
        'North Hollywood',
        'Studio City',
      ].map((city) => (
        <div class="flex items-center gap-2 text-zinc-700">
          <span class="text-amber-500">&#10003;</span>
          {city}
        </div>
      ))}
    </div>
    <p class="mt-6 text-zinc-600">
      Don't see your area listed? <a href="/contact" class="font-semibold text-amber-600 underline">Contact us</a> —
      we may still cover your neighborhood.
    </p>
  </section>

  <!-- Before / After -->
  <section class="bg-zinc-50 py-16">
    <div class="mx-auto max-w-4xl px-6">
      <h2 class="text-3xl font-bold text-zinc-900">Before & After</h2>
      <p class="mt-4 text-zinc-600">
        See the difference our mobile wheel repair makes. (Add your before/after photos here.)
      </p>
      <div class="mt-8 grid gap-6 sm:grid-cols-2">
        <div class="overflow-hidden rounded-xl bg-zinc-200">
          <!-- Replace with actual before image -->
          <div class="flex aspect-video items-center justify-center text-zinc-400">Before Photo</div>
        </div>
        <div class="overflow-hidden rounded-xl bg-zinc-200">
          <!-- Replace with actual after image -->
          <div class="flex aspect-video items-center justify-center text-zinc-400">After Photo</div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="mx-auto max-w-3xl px-6 py-16">
    <h2 class="text-3xl font-bold text-zinc-900">Frequently Asked Questions</h2>
    <div class="mt-8 space-y-6">
      <div>
        <h3 class="text-lg font-semibold text-zinc-900">How does mobile wheel repair work?</h3>
        <p class="mt-2 text-zinc-600">
          We come to your home, office, or any location in Los Angeles. Our technician arrives with
          all the equipment needed to repair your wheels on-site — no need to leave your vehicle at
          a shop.
        </p>
      </div>
      <div>
        <h3 class="text-lg font-semibold text-zinc-900">How long does curb rash repair take?</h3>
        <p class="mt-2 text-zinc-600">
          Most curb rash repairs take 30–60 minutes per wheel depending on severity. We can
          typically complete all four wheels in a single visit.
        </p>
      </div>
      <div>
        <h3 class="text-lg font-semibold text-zinc-900">Do you serve my part of Los Angeles?</h3>
        <p class="mt-2 text-zinc-600">
          We cover the greater LA area from Pasadena to Marina del Rey. If you're unsure whether we
          reach your neighborhood, just call or text us.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-gradient-to-br from-zinc-900 to-zinc-800 py-16">
    <div class="mx-auto max-w-3xl px-6 text-center">
      <h2 class="text-3xl font-bold text-white">Ready to Fix Your Wheels?</h2>
      <p class="mt-4 text-lg text-zinc-300">
        Mobile wheel repair anywhere in Los Angeles. Call, text, or book online today.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a
          href="/contact"
          class="rounded-lg bg-amber-500 px-8 py-3 text-base font-semibold text-black transition hover:bg-amber-400"
        >
          Get a Free Quote
        </a>
        <a
          href="tel:+16268632885"
          class="rounded-lg border border-zinc-600 px-8 py-3 text-base font-semibold text-white transition hover:border-zinc-400"
        >
          Call or Text
        </a>
      </div>
    </div>
  </section>

  <!-- Internal link to OC page -->
  <section class="mx-auto max-w-3xl px-6 py-10 text-center">
    <p class="text-zinc-500">
      Also serving Orange County —
      <a href="/wheel-repair-orange-county" class="font-semibold text-amber-600 underline">
        Wheel Repair Orange County
      </a>
    </p>
  </section>
</Layout>
