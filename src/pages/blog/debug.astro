---
// Página de debug para verificar la API de Hashnode
export const prerender = false;

const HASHNODE_HOST = 'hrzwheel.hashnode.dev';

// Test directo a la API
const testQuery = `
    query Publication($host: String!) {
        publication(host: $host) {
            id
            title
            posts(first: 5) {
                edges {
                    node {
                        id
                        title
                        slug
                        publishedAt
                    }
                }
            }
        }
    }
`;

let result = null;
let error = null;

try {
    const response = await fetch('https://gql.hashnode.com', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
        },
        body: JSON.stringify({
            query: testQuery,
            variables: { host: HASHNODE_HOST }
        })
    });

    result = await response.json();
} catch (e) {
    error = e.message;
}
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hashnode Debug</title>
    <style>
        body {
            font-family: monospace;
            padding: 20px;
            background: #1a1a1a;
            color: #fff;
        }
        pre {
            background: #2d2d2d;
            padding: 20px;
            border-radius: 8px;
            overflow-x: auto;
        }
        .error {
            color: #ff4444;
        }
        .success {
            color: #44ff44;
        }
    </style>
</head>
<body>
    <h1>🔍 Hashnode API Debug</h1>
    
    <h2>Configuration:</h2>
    <pre>Host: {HASHNODE_HOST}</pre>

    {error && (
        <div class="error">
            <h2>❌ Error:</h2>
            <pre>{error}</pre>
        </div>
    )}

    {result && (
        <div class="success">
            <h2>✅ API Response:</h2>
            <pre>{JSON.stringify(result, null, 2)}</pre>
        </div>
    )}

    {result?.data?.publication?.posts?.edges && (
        <div>
            <h2>📝 Available Posts:</h2>
            <ul>
                {result.data.publication.posts.edges.map(edge => (
                    <li>
                        <strong>{edge.node.title}</strong>
                        <br />
                        Slug: <code>{edge.node.slug}</code>
                        <br />
                        URL: <a href={`/blog/${edge.node.slug}`} style="color: #44aaff;">
                            /blog/{edge.node.slug}
                        </a>
                    </li>
                ))}
            </ul>
        </div>
    )}

    <hr style="margin: 40px 0; border-color: #444;">
    
    <p><a href="/blog" style="color: #44aaff;">← Back to Blog</a></p>
</body>
</html>
