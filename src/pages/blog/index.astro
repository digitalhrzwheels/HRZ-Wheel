---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { sanityClient, urlFor } from '../../lib/sanity';

// Static Site Generation (SSG) for best performance
export const prerender = true;

// Fetch posts from Sanity
const query = `*[_type == "post"] | order(publishedAt desc) {
  title,
  "slug": slug.current,
  publishedAt,
  mainImage,
  "brief": pt::text(body),
  "tags": categories[]->{title}
}`;

let posts = [];
try {
    posts = await sanityClient.fetch(query) || [];
} catch (error) {
    console.error('Error fetching posts:', error);
    posts = [];
}

// Helper to calculate read time (approximate)
function getReadTime(text: string) {
    const wordsPerMinute = 200;
    const words = text ? text.split(/\s/g).length : 0;
    return Math.ceil(words / wordsPerMinute);
}
---

<Layout 
    title="Blog - HRZ Wheels | Expert Wheel Repair Tips & Industry News" 
    description="Expert tips, industry news, and guides about wheel restoration, customization, and automotive care from HRZ Wheels professionals."
>
    <Header />
    
    <!-- Hero Section -->
    <section class="relative bg-black pt-32 pb-20 overflow-hidden">
        <!-- Animated background effects -->
        <div class="absolute inset-0">
            <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-gold-500/20 rounded-full blur-3xl animate-pulse"></div>
            <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-gold-400/15 rounded-full blur-3xl animate-pulse" style="animation-delay: 1s;"></div>
        </div>

        <div class="container mx-auto px-6 relative z-10">
            <div class="max-w-4xl mx-auto text-center">
                <div class="inline-block mb-6">
                    <span class="bg-gold-500/10 border border-gold-500/30 text-gold-400 px-6 py-2 rounded-full text-sm font-bold uppercase tracking-wider backdrop-blur-sm">
                        📰 Industry Insights
                    </span>
                </div>
                
                <h1 class="text-5xl md:text-7xl font-display font-black mb-6 leading-tight">
                    Blog & <span class="animate-shine bg-clip-text text-transparent bg-[linear-gradient(to_right,#B5952F,#F9E588,#FDF3B7,#B5952F)] bg-[length:200%_auto]">News</span>
                </h1>
                
                <p class="text-xl md:text-2xl text-gray-300 mb-8 leading-relaxed">
                    Expert tips and industry insights on wheel restoration
                </p>

                <div class="flex items-center justify-center gap-6 text-sm text-gray-400">
                    <div class="flex items-center gap-2">
                        <div class="w-2 h-2 bg-gold-500 rounded-full animate-pulse"></div>
                        <span class="font-semibold">{posts.length} Articles</span>
                    </div>
                    <span class="text-gold-500/50">•</span>
                    <div class="flex items-center gap-2">
                        <div class="w-2 h-2 bg-gold-500 rounded-full animate-pulse" style="animation-delay: 0.5s;"></div>
                        <span class="font-semibold">Always Fresh Content</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Gradient divider -->
        <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-gold-500/50 to-transparent"></div>
    </section>

    <!-- Posts Grid -->
    <section class="py-20 bg-black relative">
        <!-- Background glow -->
        <div class="absolute inset-0 bg-gradient-to-b from-black via-zinc-950 to-black"></div>
        
        <div class="container mx-auto px-6 relative z-10">
            {posts.length === 0 ? (
                <div class="max-w-2xl mx-auto text-center py-20">
                    <div class="relative inline-block">
                        <div class="absolute inset-0 bg-gold-500/20 blur-2xl rounded-full"></div>
                        <div class="relative w-24 h-24 mx-auto mb-6 bg-gradient-to-br from-zinc-900 to-black rounded-full flex items-center justify-center border border-gold-500/20">
                            <svg class="w-12 h-12 text-gold-500/50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                            </svg>
                        </div>
                    </div>
                    <h3 class="text-2xl font-bold text-white mb-3">No posts yet</h3>
                    <p class="text-gray-400 text-lg">Check back soon for expert tips and industry insights!</p>
                </div>
            ) : (
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-7xl mx-auto">
                    {posts.map((post: any) => (
                        <article class="group relative">
                            <!-- Glow effect -->
                            <div class="absolute -inset-2 bg-gradient-to-br from-gold-500/20 via-gold-400/10 to-transparent rounded-3xl blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                            
                            <!-- Card -->
                            <div class="relative bg-gradient-to-br from-zinc-900 via-zinc-900 to-black rounded-2xl overflow-hidden border border-gold-500/20 group-hover:border-gold-500/50 shadow-2xl transition-all duration-300 transform group-hover:-translate-y-2">
                                {post.mainImage && (
                                    <a href={`/blog/${post.slug}`} class="block relative aspect-video overflow-hidden bg-black">
                                        <img 
                                            src={urlFor(post.mainImage).width(800).height(450).url()} 
                                            alt={post.title}
                                            loading="lazy"
                                            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
                                        />
                                        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-transparent"></div>
                                        
                                        <!-- Shine effect -->
                                        <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/5 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-1000"></div>
                                    </a>
                                )}
                                
                                <div class="p-6">
                                    <div class="flex items-center justify-between mb-4 text-sm">
                                        <time datetime={post.publishedAt} class="text-gray-400 font-medium">
                                            {new Date(post.publishedAt).toLocaleDateString('en-US', {
                                                month: 'short',
                                                day: 'numeric',
                                                year: 'numeric'
                                            })}
                                        </time>
                                        <div class="flex items-center gap-1 text-gold-500 font-bold">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                            </svg>
                                            <span>5 min</span>
                                        </div>
                                    </div>
                                    
                                    <h2 class="text-xl font-display font-bold text-white mb-3 line-clamp-2 group-hover:text-transparent group-hover:bg-clip-text group-hover:bg-gradient-to-r group-hover:from-gold-400 group-hover:to-white transition-all">
                                        <a href={`/blog/${post.slug}`}>
                                            {post.title}
                                        </a>
                                    </h2>
                                    
                                    <p class="text-gray-400 mb-4 line-clamp-3 leading-relaxed">
                                        {post.brief ? (post.brief.length > 200 ? post.brief.substring(0, 200) + "..." : post.brief) : "Read more about this topic in our latest blog post."}
                                    </p>
                                    
                                    {post.tags && post.tags.length > 0 && (
                                        <div class="flex flex-wrap gap-2 mb-4">
                                            {post.tags.slice(0, 3).map((tag: any) => (
                                                <span class="bg-gold-500/10 text-gold-400 px-3 py-1 rounded-lg text-xs font-semibold border border-gold-500/30 backdrop-blur-sm">
                                                    {tag.title}
                                                </span>
                                            ))}
                                        </div>
                                    )}
                                    
                                    <a 
                                        href={`/blog/${post.slug}`}
                                        class="inline-flex items-center gap-2 text-gold-500 font-bold hover:text-gold-400 transition-colors group/link"
                                    >
                                        Read More 
                                        <svg class="w-5 h-5 group-hover/link:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                                        </svg>
                                    </a>
                                </div>
                            </div>
                        </article>
                    ))}
                </div>
            )}
        </div>
    </section>

    <!-- CTA Section -->
    <section class="py-20 bg-black relative overflow-hidden border-t border-gold-500/20">
        <!-- Background effects -->
        <div class="absolute inset-0">
            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-gold-500/20 rounded-full blur-3xl"></div>
        </div>
        
        <div class="container mx-auto px-6 text-center relative z-10">
            <h2 class="text-3xl md:text-5xl font-display font-black mb-6">
                Need <span class="text-transparent bg-clip-text bg-gradient-to-r from-gold-400 via-gold-500 to-gold-400">Professional</span> Wheel Repair?
            </h2>
            <p class="text-xl text-gray-300 mb-8 max-w-2xl mx-auto">
                Get expert service from the team behind these insights
            </p>
            <a 
                href="/quote" 
                class="inline-flex items-center gap-3 bg-gradient-to-r from-gold-500 to-gold-600 hover:from-gold-600 hover:to-gold-700 text-black px-10 py-4 rounded-full font-bold text-lg transition-all transform hover:scale-105 shadow-lg shadow-gold-500/30 hover:shadow-gold-500/50"
            >
                Get a Free Quote
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                </svg>
            </a>
        </div>
    </section>

    <Footer />
</Layout>

<style>
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    
    .line-clamp-3 {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    @keyframes gradient {
        0%, 100% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
    }

    .animate-gradient {
        background-size: 200% 200%;
        animation: gradient 3s ease infinite;
    }

    .animate-shine {
        animation: shine 8s linear infinite;
        will-change: background-position;
        transform: translateZ(0);
        backface-visibility: hidden;
    }

    @keyframes shine {
        from {
            background-position: 0% center;
        }
        to {
            background-position: 200% center;
        }
    }
</style>
