---
// Pre-renderizar esta página como estática
export const prerender = true;

import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { Image } from "astro:assets";

// Import Alloy Wheel Repair Gallery Images
// Audi Wheel
import audiWheel1 from "../assets/HRZ Repair Gallery/Audi Wheel/30AB94D0-13DD-4DE1-8EBA-2B48F78A2F6E.jpg";
import audiWheel2 from "../assets/HRZ Repair Gallery/Audi Wheel/796184D7-58BC-4738-8202-B25FC1B2D106.jpg";
import audiWheel3 from "../assets/HRZ Repair Gallery/Audi Wheel/97D1473E-0B4D-4FA2-B9B4-D9603F8F81A5.jpg";

// Before and After Wheels
import beforeAfter1 from "../assets/HRZ Repair Gallery/Before and After Wheels/Ford Fusion befor and after.jpg";
import beforeAfter2 from "../assets/HRZ Repair Gallery/Before and After Wheels/Yelp_HRZ-Aaron-mercedes-S63.jpg";

// Honda Wheel
import hondaWheel1 from "../assets/HRZ Repair Gallery/Honda Wheel/IMG_5638 2.jpg";
import hondaWheel2 from "../assets/HRZ Repair Gallery/Honda Wheel/IMG_6563 2.jpg";

// Subaru Wheel (Gold)
import subaruWheel1 from "../assets/HRZ Repair Gallery/Subaru Wheel (Gold)/IMG_3632.jpg";
import subaruWheel2 from "../assets/HRZ Repair Gallery/Subaru Wheel (Gold)/IMG_6259.jpg";

// Tesla wheel (Silver)
import teslaWheel1 from "../assets/HRZ Repair Gallery/Tesla wheel (Silver)  /20160913_131255.jpg";
import teslaWheel2 from "../assets/HRZ Repair Gallery/Tesla wheel (Silver)  /20160913_131303.jpg";
import teslaWheel3 from "../assets/HRZ Repair Gallery/Tesla wheel (Silver)  /20160913_141107.jpg";
import teslaWheel4 from "../assets/HRZ Repair Gallery/Tesla wheel (Silver)  /20160913_141118.jpg";
import teslaWheel5 from "../assets/HRZ Repair Gallery/Tesla wheel (Silver)  /20160913_141132.jpg";

// Bumper Repair
import bumper1 from "../assets/HRZ Repair Gallery/Bumper Repair/IMG_8003.jpg";
import bumper2 from "../assets/HRZ Repair Gallery/Bumper Repair/IMG_8004.jpg";
import bumper3 from "../assets/HRZ Repair Gallery/Bumper Repair/IMG_8006.jpg";
import bumper4 from "../assets/HRZ Repair Gallery/Bumper Repair/IMG_8007.jpg";
import bumper5 from "../assets/HRZ Repair Gallery/Bumper Repair/IMG_8011.jpg";
import bumper6 from "../assets/HRZ Repair Gallery/Bumper Repair/IMG_8013.jpg";
import bumper7 from "../assets/HRZ Repair Gallery/Bumper Repair/IMG_8014.jpg";
import bumper8 from "../assets/HRZ Repair Gallery/Bumper Repair/IMG_8017.jpg";
import bumper9 from "../assets/HRZ Repair Gallery/Bumper Repair/IMG_8021.jpg";
import bumper10 from "../assets/HRZ Repair Gallery/Bumper Repair/IMG_8023.jpg";
import bumper11 from "../assets/HRZ Repair Gallery/Bumper Repair/IMG_8029.jpg";
import bumper12 from "../assets/HRZ Repair Gallery/Bumper Repair/IMG_8030.jpg";
import bumper13 from "../assets/HRZ Repair Gallery/Bumper Repair/IMG_8032.jpg";
import bumper14 from "../assets/HRZ Repair Gallery/Bumper Repair/IMG_8034.jpg";

// Video paths (served from public directory)
const hondaVideo = "/videos/HRZ Repair Gallery/Honda Wheel/IMG_6564 2.mp4";
const subaruVideo = "/videos/HRZ Repair Gallery/Subaru Wheel (Gold)/IMG_9856.mp4";

// Type definitions for gallery items
type GalleryImageItem = {
    src: ImageMetadata;
    alt: string;
    type: "image";
};

type GalleryVideoItem = {
    src: string;
    alt: string;
    type: "video";
};

type GalleryItem = GalleryImageItem | GalleryVideoItem;

// Gallery data structure
const alloyWheelRepair = {
    title: "Alloy Wheel Repair",
    id: "alloy-wheel-repair",
    subsections: [
        {
            name: "Audi Wheel Repair",
            items: [
                { src: audiWheel1, alt: "Audi alloy wheel curb rash repair before and after", type: "image" as const },
                { src: audiWheel2, alt: "Audi wheel restoration professional service Los Angeles", type: "image" as const },
                { src: audiWheel3, alt: "Audi rim refinishing mobile service Orange County", type: "image" as const },
            ] as GalleryItem[]
        },
        {
            name: "Before & After Transformations",
            items: [
                { src: beforeAfter1, alt: "Ford Fusion wheel repair before and after transformation", type: "image" as const },
                { src: beforeAfter2, alt: "Mercedes S63 AMG wheel repair customer testimonial", type: "image" as const },
            ] as GalleryItem[]
        },
        {
            name: "Honda Wheel Repair",
            items: [
                { src: hondaWheel1, alt: "Honda alloy wheel curb damage repair service", type: "image" as const },
                { src: hondaWheel2, alt: "Honda rim restoration mobile service LA", type: "image" as const },
                { src: hondaVideo, alt: "Honda wheel repair process video demonstration", type: "video" as const },
            ] as GalleryItem[]
        },
        {
            name: "Subaru Wheel Repair (Gold Finish)",
            items: [
                { src: subaruWheel1, alt: "Subaru gold alloy wheel repair and refinishing", type: "image" as const },
                { src: subaruWheel2, alt: "Subaru wheel restoration gold finish service", type: "image" as const },
                { src: subaruVideo, alt: "Subaru wheel repair video showcase", type: "video" as const },
            ] as GalleryItem[]
        },
        {
            name: "Tesla Wheel Repair (Silver Finish)",
            items: [
                { src: teslaWheel1, alt: "Tesla alloy wheel curb rash repair silver finish", type: "image" as const },
                { src: teslaWheel2, alt: "Tesla rim restoration mobile service Los Angeles", type: "image" as const },
                { src: teslaWheel3, alt: "Tesla wheel refinishing professional service", type: "image" as const },
                { src: teslaWheel4, alt: "Tesla alloy wheel repair before and after", type: "image" as const },
                { src: teslaWheel5, alt: "Tesla wheel damage restoration service OC", type: "image" as const },
            ] as GalleryItem[]
        },
    ]
};

const bumperRepair = {
    title: "Bumper Spot Repair",
    id: "bumper-repair",
    items: [
        { src: bumper1, alt: "Professional bumper spot repair service Los Angeles", type: "image" as const },
        { src: bumper2, alt: "Bumper scratch repair and refinishing Orange County", type: "image" as const },
        { src: bumper3, alt: "Mobile bumper repair service before and after", type: "image" as const },
        { src: bumper4, alt: "Bumper scuff repair professional service LA", type: "image" as const },
        { src: bumper5, alt: "Bumper damage restoration mobile service", type: "image" as const },
        { src: bumper6, alt: "Bumper paint repair and color matching service", type: "image" as const },
        { src: bumper7, alt: "Professional bumper refinishing service OC", type: "image" as const },
        { src: bumper8, alt: "Bumper repair transformation before after photos", type: "image" as const },
        { src: bumper9, alt: "Mobile bumper spot repair service Los Angeles", type: "image" as const },
        { src: bumper10, alt: "Bumper scratch removal professional service", type: "image" as const },
        { src: bumper11, alt: "Bumper repair service Orange County mobile", type: "image" as const },
        { src: bumper12, alt: "Professional bumper restoration service LA", type: "image" as const },
        { src: bumper13, alt: "Bumper damage repair mobile service Orange County", type: "image" as const },
        { src: bumper14, alt: "Bumper spot repair before and after results", type: "image" as const },
    ] as GalleryItem[]
};

---

<Layout
    title="Gallery - Professional Wheel & Bumper Repair | HRZ Wheel Repair Los Angeles & Orange County"
    description="Browse our professional wheel and bumper repair gallery. Real before & after photos of alloy wheel repair, curb rash repair, rim refinishing & bumper spot repair. Mobile service in LA & OC. 5000+ wheels restored."
>
    <Header />
    
    <main class="min-h-screen bg-black pt-24 pb-16 relative overflow-hidden">
        <!-- Background Effects -->
        <div class="absolute inset-0 overflow-hidden pointer-events-none">
            <!-- Golden glow top right -->
            <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-gold-500/20 rounded-full blur-[120px] animate-pulse"></div>
            <!-- Blue glow left -->
            <div class="absolute top-1/4 left-0 w-[500px] h-[500px] bg-blue-500/15 rounded-full blur-[100px]"></div>
            <!-- Golden glow bottom -->
            <div class="absolute bottom-0 right-1/3 w-[700px] h-[700px] bg-gold-500/10 rounded-full blur-[130px]"></div>
            <!-- Blue accent middle -->
            <div class="absolute top-1/2 right-1/4 w-[400px] h-[400px] bg-bmw-blue/10 rounded-full blur-[90px]"></div>
        </div>

        <!-- Hero Section -->
        <section class="container mx-auto px-6 mb-16 relative z-10">
            <div class="text-center max-w-5xl mx-auto">
                <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6">
                    <span class="bg-gradient-to-r from-gold-500 to-white bg-clip-text text-transparent">
                        Our Work
                    </span>
                </h1>
                <p class="text-gray-300 text-base md:text-lg leading-relaxed">
                    Explore our portfolio of professional wheel and bumper repair transformations. 
                    Real before & after photos showcasing curb rash repair, rim refinishing, alloy wheel restoration, and bumper spot repair.
                    Over 5,000 wheels restored to perfection in Los Angeles & Orange County.
                </p>
            </div>
        </section>

        <!-- Alloy Wheel Repair Section -->
        <section id="alloy-wheel-repair" class="container mx-auto px-6 mb-20 relative z-10 scroll-mt-24">
            <div class="text-center mb-12">
                <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold mb-4">
                    <span class="bg-gradient-to-r from-red-500 to-red-300 bg-clip-text text-transparent drop-shadow-[0_0_15px_rgba(255,255,255,0.5)]">
                        Alloy Wheel Repair
                    </span>
                </h2>
                <p class="text-gray-400 text-sm md:text-base max-w-3xl mx-auto">
                    Professional curb rash repair, rim refinishing, and alloy wheel restoration for all makes and models
                </p>
            </div>

            {alloyWheelRepair.subsections.map((subsection) => (
                <div class="mb-12">
                    <h3 class="text-xl md:text-2xl font-bold text-white mb-4 flex items-center gap-3">
                        <span class="w-2 h-2 bg-red-500 rounded-full shadow-[0_0_10px_rgba(255,255,255,0.6)]"></span>
                        {subsection.name}
                    </h3>
                    
                    <!-- Desktop Grid -->
                    <div class="hidden md:grid md:grid-cols-3 lg:grid-cols-4 gap-4">
                        {subsection.items.map((item, index) => (
                            <div 
                                class="gallery-item group relative overflow-hidden rounded-xl bg-zinc-900 border border-white/10 hover:border-red-500/50 transition-all duration-300 cursor-pointer aspect-square"
                                data-src={item.type === 'image' ? (item.src as ImageMetadata).src : item.src}
                                data-alt={item.alt}
                                data-type={item.type}
                            <Image
    src={item.src as ImageMetadata}
    alt={item.alt}
    widths={[240, 480, 960]}
    sizes="(max-width: 768px) 75vw, (max-width: 1024px) 33vw, 25vw"
    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
    loading="lazy"
/>

                                ) : (
                                    <div class="relative w-full h-full bg-zinc-950 flex items-center justify-center">
                                        <video
                                            src={item.src as string}
                                            class="w-full h-full object-cover"
                                            muted
                                            loop
                                            playsinline
                                        />
                                        <div class="absolute inset-0 flex items-center justify-center bg-black/30">
                                            <div class="w-16 h-16 rounded-full bg-red-500/90 flex items-center justify-center shadow-[0_0_20px_rgba(255,255,255,0.8)]">
                                                <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="w-8 h-8 text-black ml-1">
                                                    <path d="M8 5v14l11-7z"/>
                                                </svg>
                                            </div>
                                        </div>
                                    </div>
                                )}
                                <!-- Overlay -->
                                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-6">
                                    <div class="text-white">
                                        <p class="text-sm font-medium text-red-400 mb-1">Click to view</p>
                                        <p class="text-xs text-gray-300">{item.alt}</p>
                                    </div>
                                </div>
                            </div>
                        ))}
                    </div>

                    <!-- Mobile Slider -->
                    <div class="md:hidden relative">
                        <!-- Scroll Indicator -->
                        <div class="absolute top-1/2 right-2 -translate-y-1/2 z-10 bg-black/50 backdrop-blur-sm rounded-full p-2 pointer-events-none">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 text-white animate-pulse">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                            </svg>
                        </div>
                        <div class="overflow-x-auto snap-x snap-mandatory scrollbar-hide flex gap-4 pb-4" style="-webkit-overflow-scrolling: touch;">
                            {subsection.items.map((item) => (
                                <div 
                                    class="gallery-item flex-shrink-0 w-[75vw] relative overflow-hidden rounded-xl bg-zinc-900 border border-white/10 aspect-square snap-center"
                                    data-src={item.type === 'image' ? (item.src as ImageMetadata).src : item.src}
                                    data-alt={item.alt}
                                    data-type={item.type}
                                >
                                    {item.type === 'image' ? (
                                        <Image
    src={item.src as ImageMetadata}
    alt={item.alt}
    widths={[240, 480]}
    sizes="75vw"
    class="w-full h-full object-cover"
    loading="lazy"
/>

                                    ) : (
                                        <div class="relative w-full h-full bg-zinc-950 flex items-center justify-center">
                                            <video
                                                src={item.src as string}
                                                class="w-full h-full object-cover"
                                                muted
                                                loop
                                                playsinline
                                            />
                                            <div class="absolute inset-0 flex items-center justify-center bg-black/30">
                                                <div class="w-16 h-16 rounded-full bg-gold-500/90 flex items-center justify-center">
                                                    <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="w-8 h-8 text-black ml-1">
                                                        <path d="M8 5v14l11-7z"/>
                                                    </svg>
                                                </div>
                                            </div>
                                        </div>
                                    )}
                                </div>
                            ))}
                        </div>
                    </div>
                </div>
            ))}
        </section>

        <!-- Bumper Repair Section -->
        <section id="bumper-repair" class="container mx-auto px-6 mb-20 relative z-10 scroll-mt-24">
            <div class="text-center mb-12">
                <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold mb-4">
                    <span class="bg-gradient-to-r from-bmw-blue to-blue-300 bg-clip-text text-transparent">
                        Bumper Spot Repair
                    </span>
                </h2>
                <p class="text-gray-400 text-sm md:text-base max-w-3xl mx-auto">
                    Expert bumper scratch and scuff repair with professional refinishing and color matching
                </p>
            </div>

            <!-- Desktop Grid -->
            <div class="hidden md:grid md:grid-cols-3 lg:grid-cols-4 gap-4">
                {bumperRepair.items.map((item) => (
                    <div 
                        class="gallery-item group relative overflow-hidden rounded-xl bg-zinc-900 border border-white/10 hover:border-bmw-blue/50 transition-all duration-300 cursor-pointer aspect-square"
                        data-src={item.type === 'image' ? (item.src as ImageMetadata).src : item.src}
                        data-alt={item.alt}
                        data-type={item.type}
                    >
                        {item.type === 'image' ? (
                            <Image
                                src={item.src as ImageMetadata}
                                alt={item.alt}
                                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                                loading="lazy"
                            />
                        ) : (
                            <div class="relative w-full h-full bg-zinc-950 flex items-center justify-center">
                                <video
                                    src={item.src as string}
                                    class="w-full h-full object-cover"
                                    muted
                                    loop
                                    playsinline
                                />
                                <div class="absolute inset-0 flex items-center justify-center bg-black/30">
                                    <div class="w-16 h-16 rounded-full bg-bmw-blue/90 flex items-center justify-center">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="w-8 h-8 text-white ml-1">
                                            <path d="M8 5v14l11-7z"/>
                                        </svg>
                                    </div>
                                </div>
                            </div>
                        )}
                        <!-- Overlay -->
                        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-6">
                            <div class="text-white">
                                <p class="text-sm font-medium text-bmw-blue mb-1">Click to view</p>
                                <p class="text-xs text-gray-300">{item.alt}</p>
                            </div>
                        </div>
                    </div>
                ))}
            </div>

            <!-- Mobile Slider -->
            <div class="md:hidden relative">
                <!-- Scroll Indicator -->
                <div class="absolute top-1/2 right-2 -translate-y-1/2 z-10 bg-black/50 backdrop-blur-sm rounded-full p-2 pointer-events-none">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 text-white animate-pulse">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                    </svg>
                </div>
                <div class="overflow-x-auto snap-x snap-mandatory scrollbar-hide flex gap-4 pb-4" style="-webkit-overflow-scrolling: touch;">
                    {bumperRepair.items.map((item) => (
                        <div 
                            class="gallery-item flex-shrink-0 w-[75vw] relative overflow-hidden rounded-xl bg-zinc-900 border border-white/10 aspect-square snap-center"
                            data-src={item.type === 'image' ? (item.src as ImageMetadata).src : item.src}
                            data-alt={item.alt}
                            data-type={item.type}
                        >
                            {item.type === 'image' ? (
                                <Image
                                    src={item.src as ImageMetadata}
                                    alt={item.alt}
                                    class="w-full h-full object-cover"
                                    loading="lazy"
                                />
                            ) : (
                                <div class="relative w-full h-full bg-zinc-950 flex items-center justify-center">
                                    <video
                                        src={item.src as string}
                                        class="w-full h-full object-cover"
                                        muted
                                        loop
                                        playsinline
                                    />
                                    <div class="absolute inset-0 flex items-center justify-center bg-black/30">
                                        <div class="w-16 h-16 rounded-full bg-bmw-blue/90 flex items-center justify-center">
                                            <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="w-8 h-8 text-white ml-1">
                                                <path d="M8 5v14l11-7z"/>
                                            </svg>
                                        </div>
                                    </div>
                                </div>
                            )}
                        </div>
                    ))}
                </div>
            </div>
        </section>


        <!-- CTA Section -->
        <section class="container mx-auto px-6 mt-20 relative z-10">
            <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-zinc-900 to-black border border-white/10 p-12 text-center">
                <!-- Background Effect -->
                <div class="absolute inset-0 bg-gradient-to-br from-gold-500/5 to-transparent"></div>
                <div class="absolute top-0 right-0 w-96 h-96 bg-gold-500/10 rounded-full blur-3xl"></div>
                
                <div class="relative z-10">
                    <h2 class="text-3xl md:text-4xl font-bold mb-4">
                        <span class="bg-gradient-to-r from-gold-500 to-white bg-clip-text text-transparent">
                            Ready to Restore Your Wheels or Bumper?
                        </span>
                    </h2>
                    <p class="text-gray-300 text-lg mb-8 max-w-2xl mx-auto">
                        Get a free quote today and experience the same premium quality service
                    </p>
                    <a
                        href="/quote"
                        class="inline-block bg-gold-500 hover:bg-gold-400 text-black px-8 py-4 rounded-full font-bold text-lg transition-all transform hover:scale-105 shadow-lg shadow-gold-500/20"
                    >
                        Request a Free Quote
                    </a>
                </div>
            </div>
        </section>
    </main>

    <!-- Lightbox -->
    <div id="lightbox" class="fixed inset-0 bg-black/95 backdrop-blur-xl z-50 hidden items-center justify-center p-4">
        <!-- Close Button -->
        <button
            id="lightbox-close"
            class="absolute top-6 right-6 w-12 h-12 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center text-white transition-all z-50 group"
            aria-label="Close lightbox"
        >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6 group-hover:rotate-90 transition-transform duration-300">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
        </button>

        <!-- Previous Button -->
        <button
            id="lightbox-prev"
            class="absolute left-6 w-12 h-12 rounded-full bg-white/10 hover:bg-gold-500 flex items-center justify-center text-white transition-all z-50"
            aria-label="Previous image"
        >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
            </svg>
        </button>

        <!-- Next Button -->
        <button
            id="lightbox-next"
            class="absolute right-6 w-12 h-12 rounded-full bg-white/10 hover:bg-gold-500 flex items-center justify-center text-white transition-all z-50"
            aria-label="Next image"
        >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
            </svg>
        </button>

        <!-- Content Container -->
        <div id="lightbox-content" class="relative max-w-6xl max-h-[90vh] w-full h-full flex items-center justify-center">
            <img
                id="lightbox-image"
                src=""
                alt=""
                class="max-w-full max-h-full object-contain rounded-lg shadow-2xl hidden"
            />
            <video
                id="lightbox-video"
                src=""
                class="max-w-full max-h-full object-contain rounded-lg shadow-2xl hidden"
                controls
                playsinline
            ></video>
        </div>

        <!-- Counter -->
        <div class="absolute bottom-6 left-1/2 -translate-x-1/2 bg-black/50 backdrop-blur-sm px-6 py-3 rounded-full text-white text-sm font-medium">
            <span id="lightbox-counter">1 / 1</span>
        </div>
    </div>

    <Footer />

    <script>
        // Gallery and Lightbox functionality
        const allGalleryItems = document.querySelectorAll('.gallery-item');
        const lightbox = document.getElementById('lightbox');
        const lightboxImage = document.getElementById('lightbox-image') as HTMLImageElement;
        const lightboxVideo = document.getElementById('lightbox-video') as HTMLVideoElement;
        const lightboxCounter = document.getElementById('lightbox-counter');
        const lightboxClose = document.getElementById('lightbox-close');
        const lightboxPrev = document.getElementById('lightbox-prev');
        const lightboxNext = document.getElementById('lightbox-next');

        let currentIndex = 0;

        // Media sources - use a Map to avoid duplicates
        const mediaMap = new Map<string, { src: string; alt: string; type: string }>();
        
        // Populate unique media sources from gallery items
        allGalleryItems.forEach((item) => {
            const src = item.getAttribute('data-src') || '';
            const alt = item.getAttribute('data-alt') || '';
            const type = item.getAttribute('data-type') || 'image';
            
            // Use src as key to avoid duplicates
            if (!mediaMap.has(src)) {
                mediaMap.set(src, { src, alt, type });
            }
        });

        // Convert map to array for easier indexing
        const mediaSources = Array.from(mediaMap.values());
        const totalItems = mediaSources.length;

        function openLightbox(index: number) {
            currentIndex = index;
            updateLightboxMedia();
            lightbox?.classList.remove('hidden');
            lightbox?.classList.add('flex');
            document.body.classList.add('overflow-hidden');
        }

        function closeLightbox() {
            lightbox?.classList.add('hidden');
            lightbox?.classList.remove('flex');
            document.body.classList.remove('overflow-hidden');
            // Pause video if playing
            if (lightboxVideo) {
                lightboxVideo.pause();
            }
        }

        function updateLightboxMedia() {
            const media = mediaSources[currentIndex];
            if (!media) return;

            if (media.type === 'image') {
                lightboxImage.src = media.src;
                lightboxImage.alt = media.alt;
                lightboxImage.classList.remove('hidden');
                lightboxVideo.classList.add('hidden');
                lightboxVideo.pause();
            } else {
                lightboxVideo.src = media.src;
                lightboxVideo.classList.remove('hidden');
                lightboxImage.classList.add('hidden');
            }

            if (lightboxCounter) {
                lightboxCounter.textContent = `${currentIndex + 1} / ${totalItems}`;
            }
        }

        function showNext() {
            currentIndex = (currentIndex + 1) % totalItems;
            updateLightboxMedia();
        }

        function showPrev() {
            currentIndex = (currentIndex - 1 + totalItems) % totalItems;
            updateLightboxMedia();
        }

        // Event listeners - map each item to its unique media index
        allGalleryItems.forEach((item) => {
            item.addEventListener('click', () => {
                const src = item.getAttribute('data-src') || '';
                // Find the index in the unique mediaSources array
                const index = mediaSources.findIndex(media => media.src === src);
                if (index !== -1) {
                    openLightbox(index);
                }
            });
        });

        lightboxClose?.addEventListener('click', closeLightbox);
        lightboxNext?.addEventListener('click', showNext);
        lightboxPrev?.addEventListener('click', showPrev);

        // Close on background click
        lightbox?.addEventListener('click', (e) => {
            if (e.target === lightbox) {
                closeLightbox();
            }
        });

        // Keyboard navigation
        document.addEventListener('keydown', (e) => {
            if (!lightbox?.classList.contains('hidden')) {
                if (e.key === 'Escape') closeLightbox();
                if (e.key === 'ArrowRight') showNext();
                if (e.key === 'ArrowLeft') showPrev();
            }
        });

        // Smooth scroll to section on page load if hash is present
        window.addEventListener('load', () => {
            if (window.location.hash) {
                const target = document.querySelector(window.location.hash);
                if (target) {
                    setTimeout(() => {
                        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }, 100);
                }
            }
        });
    </script>

    <style>
        /* Smooth animations */
        #lightbox {
            animation: fadeIn 0.3s ease-in-out;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
            }
            to {
                opacity: 1;
            }
        }

        #lightbox-image,
        #lightbox-video {
            animation: zoomIn 0.3s ease-in-out;
        }

        @keyframes zoomIn {
            from {
                opacity: 0;
                transform: scale(0.9);
            }
            to {
                opacity: 1;
                transform: scale(1);
            }
        }

        /* Hide scrollbar for mobile sliders */
        .scrollbar-hide::-webkit-scrollbar {
            display: none;
        }
        .scrollbar-hide {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
</Layout>
