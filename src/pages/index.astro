---
// Pre-renderizar esta página como estática
export const prerender = true;

import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Brands from "../components/Brands.astro";
import AboutUs from "../components/AboutUs.astro";
import Offer from "../components/Offer_v02.astro";
import Services from "../components/Services.astro";
import Testimonials from "../components/Testimonials.astro";
import Footer from "../components/Footer.astro";
---

<Layout
	title="HRZ Wheel | Mobile Wheel Repair Los Angeles & Orange County"
	description="Expert repair for scratched or scuffed wheels in LA & OC. Curb rash, rim cosmetic repair & bumper spot repair. 10 years, 5000+ wheels. (626) 863-2885"
>
	<Header />
	<main>
		<Hero />
		<Brands />
		<AboutUs />
		<Offer />
		<Services />
						<Testimonials />
		<section class="py-20 px-6 bg-zinc-950">
			<div class="mx-auto max-w-4xl text-center">
				<h2 class="text-2xl md:text-3xl font-bold text-white mb-4">Serving Los Angeles & Orange County</h2>
				<p class="text-gray-400 mb-8 max-w-2xl mx-auto">
					Mobile wheel repair at your home or office across LA and OC. Curb rash repair, rim refinishing, and bumper spot repair.
				</p>
				<div class="flex flex-col sm:flex-row items-center justify-center gap-4">
					<a href="/wheel-repair-los-angeles" class="border border-gold-500 text-gold-500 hover:bg-gold-500 hover:text-black px-6 py-3 rounded-full font-bold transition-all">
						Wheel Repair Los Angeles
					</a>
					<a href="/wheel-repair-orange-county" class="border border-gold-500 text-gold-500 hover:bg-gold-500 hover:text-black px-6 py-3 rounded-full font-bold transition-all">
						Wheel Repair Orange County
					</a>
				</div>
			</div>
		</section>
	</main>

	<Footer />
</Layout>
