---
// Pre-renderizar esta página como estática
export const prerender = true;

import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Brands from "../components/Brands.astro";
import AboutUs from "../components/AboutUs.astro";
import Offer from "../components/Offer_v02.astro";
import Services from "../components/Services.astro";
import Testimonials from "../components/Testimonials.astro";
import Footer from "../components/Footer.astro";
---

<Layout
	title="HRZ Wheel | Mobile Wheel Repair Los Angeles & Orange County"
	description="Expert repair for scratched or scuffed wheels in LA & OC. Curb rash, rim cosmetic repair & bumper spot repair. 10 years, 5000+ wheels. (626) 863-2885"
>
	<Header />
	<main>
		<Hero />
		<Brands />
		<AboutUs />
		<Offer />
		<Services />
				<Testimonials />
		<section style="text-align: center; padding: 3rem 0;">
			<a href="/gallery/" style="display: inline-block; padding: 1rem 2rem; background: #0070f3; color: white; text-decoration: none; border-radius: 8px; font-size: 1.2rem;">View Our Before & After Gallery</a>
		</section>
	</main>

	<Footer />
</Layout>
