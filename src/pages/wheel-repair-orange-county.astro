---
// HRZ Wheel Repair – Orange County Location Page
// URL: https://hrzwheel.com/wheel-repair-orange-county
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';

const pageData = {
  title: 'Mobile Wheel Repair in Orange County | HRZ Wheel Repair',
  description:
    'Professional mobile wheel repair in Orange County — curb rash repair and cosmetic wheel restoration delivered to your location. Serving Irvine, Anaheim, Huntington Beach & more.',
  image: '/og-image.png',
};

// FAQ schema only — business schema is already in Layout.astro
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Does HRZ Wheel Repair come to Orange County?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Our mobile wheel repair team serves Orange County including Irvine, Anaheim, Huntington Beach, Costa Mesa, Newport Beach, and surrounding cities.',
      },
    },
    {
      '@type': 'Question',
      name: 'What wheel repairs do you handle in Orange County?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'We handle curb rash repair, cosmetic wheel repair, scuff removal, and alloy wheel restoration — all performed on-site at your location.',
      },
    },
    {
      '@type': 'Question',
      name: 'How quickly can you come to Orange County?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'We typically schedule Orange County appointments within a few days, and same-week service is usually available. Call or text to check current availability.',
      },
    },
  ],
};
---

<Layout title={pageData.title} description={pageData.description} image={pageData.image}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <Header />

  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-gradient-to-br from-zinc-900 to-zinc-800 py-20 md:py-28">
    <div class="mx-auto max-w-4xl px-6 text-center">
      <h1 class="text-4xl font-bold tracking-tight text-white md:text-5xl">
        Mobile Wheel Repair in Orange County
      </h1>
      <p class="mt-4 text-lg text-zinc-300 md:text-xl">
        Curb rash repair and cosmetic wheel restoration — delivered to your home or office across
        Orange County.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a
          href="/contact"
          class="rounded-lg bg-amber-500 px-8 py-3 text-base font-semibold text-black transition hover:bg-amber-400"
        >
          Get a Free Quote
        </a>
        <a
          href="tel:+16268632885"
          class="rounded-lg border border-zinc-600 px-8 py-3 text-base font-semibold text-white transition hover:border-zinc-400"
        >
          Call or Text Us
        </a>
      </div>
    </div>
  </section>

  <!-- Services Overview -->
  <section class="mx-auto max-w-5xl px-6 py-16">
    <h2 class="text-3xl font-bold text-zinc-900">Wheel Repair Services Across Orange County</h2>
    <p class="mt-4 text-lg text-zinc-600">
      From Irvine to Huntington Beach, our mobile technicians bring professional wheel repair to
      your driveway, office parking lot, or anywhere in OC.
    </p>

    <div class="mt-10 grid gap-8 md:grid-cols-3">
      <div class="rounded-xl border border-zinc-200 p-6">
        <h3 class="text-xl font-semibold text-zinc-900">Curb Rash Repair</h3>
        <p class="mt-2 text-zinc-600">
          Curb damage on your rims? We repair scrapes, gouges, and scuffs on-site and refinish the
          wheel to match its original look.
        </p>
      </div>
      <div class="rounded-xl border border-zinc-200 p-6">
        <h3 class="text-xl font-semibold text-zinc-900">Cosmetic Wheel Repair</h3>
        <p class="mt-2 text-zinc-600">
          Scratches, chips, peeling clear coat, and faded finishes — restored to factory quality
          without removing your wheels.
        </p>
      </div>
      <div class="rounded-xl border border-zinc-200 p-6">
        <h3 class="text-xl font-semibold text-zinc-900">Mobile Service</h3>
        <p class="mt-2 text-zinc-600">
          No shop visits. We come to you anywhere in Orange County with all the tools and materials
          needed for a complete repair.
        </p>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="bg-zinc-50 py-16">
    <div class="mx-auto max-w-4xl px-6">
      <h2 class="text-3xl font-bold text-zinc-900">How Mobile Wheel Repair Works in OC</h2>
      <ol class="mt-10 space-y-8">
        <li class="flex gap-6">
          <span class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-amber-500 text-xl font-bold text-black">1</span>
          <div>
            <h3 class="text-lg font-semibold text-zinc-900">Contact Us</h3>
            <p class="mt-1 text-zinc-600">
              Call, text, or send us a message with photos of the damage and your Orange County
              location.
            </p>
          </div>
        </li>
        <li class="flex gap-6">
          <span class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-amber-500 text-xl font-bold text-black">2</span>
          <div>
            <h3 class="text-lg font-semibold text-zinc-900">Get a Quote</h3>
            <p class="mt-1 text-zinc-600">
              We'll give you a clear, upfront quote based on the wheels and damage — no surprises.
            </p>
          </div>
        </li>
        <li class="flex gap-6">
          <span class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-amber-500 text-xl font-bold text-black">3</span>
          <div>
            <h3 class="text-lg font-semibold text-zinc-900">We Come to You</h3>
            <p class="mt-1 text-zinc-600">
              Our technician arrives at your home or office in OC with everything needed for the
              repair.
            </p>
          </div>
        </li>
        <li class="flex gap-6">
          <span class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-amber-500 text-xl font-bold text-black">4</span>
          <div>
            <h3 class="text-lg font-semibold text-zinc-900">Drive Away Happy</h3>
            <p class="mt-1 text-zinc-600">
              Your wheels look brand new — without ever leaving your car at a shop.
            </p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- Service Areas -->
  <section class="mx-auto max-w-4xl px-6 py-16">
    <h2 class="text-3xl font-bold text-zinc-900">Orange County Cities We Serve</h2>
    <p class="mt-4 text-lg text-zinc-600">
      Our mobile wheel repair covers Orange County, including:
    </p>
    <div class="mt-8 grid grid-cols-2 gap-4 md:grid-cols-3">
      {[
        'Irvine',
        'Anaheim',
        'Huntington Beach',
        'Costa Mesa',
        'Newport Beach',
        'Santa Ana',
        'Orange',
        'Fullerton',
        'Garden Grove',
        'Laguna Beach',
        'Laguna Niguel',
        'Mission Viejo',
        'Tustin',
        'Fountain Valley',
        'Brea',
        'Yorba Linda',
        'Lake Forest',
        'Aliso Viejo',
      ].map((city) => (
        <div class="flex items-center gap-2 text-zinc-700">
          <span class="text-amber-500">&#10003;</span>
          {city}
        </div>
      ))}
    </div>
    <p class="mt-6 text-zinc-600">
      Not sure if we cover your city? <a href="/contact" class="font-semibold text-amber-600 underline">Contact us</a> —
      we likely do.
    </p>
  </section>

  <!-- Before / After -->
  <section class="bg-zinc-50 py-16">
    <div class="mx-auto max-w-4xl px-6">
      <h2 class="text-3xl font-bold text-zinc-900">Before & After</h2>
      <p class="mt-4 text-zinc-600">
        Real results from our Orange County wheel repairs. (Add your before/after photos here.)
      </p>
      <div class="mt-8 grid gap-6 sm:grid-cols-2">
        <div class="overflow-hidden rounded-xl bg-zinc-200">
          <!-- Replace with actual before image -->
          <div class="flex aspect-video items-center justify-center text-zinc-400">Before Photo</div>
        </div>
        <div class="overflow-hidden rounded-xl bg-zinc-200">
          <!-- Replace with actual after image -->
          <div class="flex aspect-video items-center justify-center text-zinc-400">After Photo</div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="mx-auto max-w-3xl px-6 py-16">
    <h2 class="text-3xl font-bold text-zinc-900">Frequently Asked Questions</h2>
    <div class="mt-8 space-y-6">
      <div>
        <h3 class="text-lg font-semibold text-zinc-900">Does HRZ Wheel Repair come to Orange County?</h3>
        <p class="mt-2 text-zinc-600">
          Yes. Our mobile team serves Orange County including Irvine, Anaheim, Huntington Beach,
          Costa Mesa, Newport Beach, and surrounding cities.
        </p>
      </div>
      <div>
        <h3 class="text-lg font-semibold text-zinc-900">What wheel repairs do you handle?</h3>
        <p class="mt-2 text-zinc-600">
          Curb rash repair, cosmetic wheel repair, scuff removal, and alloy wheel restoration — all
          performed on-site at your location.
        </p>
      </div>
      <div>
        <h3 class="text-lg font-semibold text-zinc-900">How quickly can you come to OC?</h3>
        <p class="mt-2 text-zinc-600">
          We typically schedule Orange County appointments within a few days, and same-week service
          is usually available. Call or text to check current availability.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-gradient-to-br from-zinc-900 to-zinc-800 py-16">
    <div class="mx-auto max-w-3xl px-6 text-center">
      <h2 class="text-3xl font-bold text-white">Need Wheel Repair in Orange County?</h2>
      <p class="mt-4 text-lg text-zinc-300">
        Mobile curb rash and cosmetic wheel repair across OC. Call, text, or book online.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a
          href="/contact"
          class="rounded-lg bg-amber-500 px-8 py-3 text-base font-semibold text-black transition hover:bg-amber-400"
        >
          Get a Free Quote
        </a>
        <a
          href="tel:+16268632885"
          class="rounded-lg border border-zinc-600 px-8 py-3 text-base font-semibold text-white transition hover:border-zinc-400"
        >
          Call or Text
        </a>
      </div>
    </div>
  </section>

  <!-- Internal link to LA page -->
  <section class="mx-auto max-w-3xl px-6 py-10 text-center">
    <p class="text-zinc-500">
      Also serving Los Angeles —
      <a href="/wheel-repair-los-angeles" class="font-semibold text-amber-600 underline">
        Mobile Wheel Repair Los Angeles
      </a>
    </p>
  </section>
</Layout>
