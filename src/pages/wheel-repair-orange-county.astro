---
// HRZ Wheel Repair – Orange County Location Page
// URL: https://hrzwheel.com/wheel-repair-orange-county
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';

const pageData = {
  title: 'Mobile Wheel Repair in Orange County | HRZ Wheel Repair',
  description:
    'Professional mobile wheel repair in Orange County — curb rash repair and cosmetic wheel restoration delivered to your location. Serving Irvine, Anaheim, Huntington Beach & more.',
  image: '/og-image.png',
};

// FAQ schema only — business schema is already in Layout.astro
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Does HRZ Wheel Repair come to Orange County?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Our mobile wheel repair team serves Orange County including Irvine, Anaheim, Huntington Beach, Costa Mesa, Newport Beach, and surrounding cities.',
      },
    },
    {
      '@type': 'Question',
      name: 'What wheel repairs do you handle in Orange County?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'We handle curb rash repair, cosmetic wheel repair, scuff removal, and alloy wheel restoration — all performed on-site at your location.',
      },
    },
       {
      '@type': 'Question',
      name: 'How quickly can you come to Orange County?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'We typically schedule Orange County appointments within a few days, and same-week service is usually available. Call or text to check current availability.',
      },
    },
    {
      '@type': 'Question',
      name: 'How much does mobile wheel repair cost in Orange County?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Pricing depends on the extent of damage and number of wheels. Most curb rash repairs start at an affordable per-wheel rate. Contact us for a free quote based on photos of your damage.',
      },
    },
    {
      '@type': 'Question',
      name: 'Do you repair all types of wheels in Orange County?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. We repair alloy wheels, including silver, gold, black, and custom finishes. We service all major brands including Audi, BMW, Mercedes, Tesla, Honda, Subaru, Lexus, and more.',
      },
    },
    {
      '@type': 'Question',
      name: 'Do I need to remove my wheels for repair?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Our mobile service performs cosmetic wheel repair with the wheels on your car, saving you time and hassle.',
      },
    },
  ],
};

---

<Layout title={pageData.title} description={pageData.description} image={pageData.image}>
  <Header />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Hero Section -->
  <section class="relative overflow-hidden pt-32 pb-20 px-6">
    <div class="absolute inset-0 bg-gradient-to-br from-black via-zinc-900 to-black"></div>
    <div class="relative mx-auto max-w-4xl text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-6">
        Mobile Wheel Repair in Orange County
      </h1>
      <p class="text-lg md:text-xl text-gray-300 mb-10">
        Curb rash repair and cosmetic wheel restoration — delivered to your home or office across
        Orange County.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/quote"
          class="bg-gold-500 hover:bg-gold-400 text-black px-8 py-3 rounded-full font-bold transition-all transform hover:scale-105"
        >
          Get a Free Quote
        </a>
        <a
          href="tel:+16268632885"
          class="border border-gold-500 text-gold-500 hover:bg-gold-500 hover:text-black px-8 py-3 rounded-full font-bold transition-all"
        >
          Call or Text Us
        </a>
      </div>
    </div>
  </section>

  <!-- Services Overview -->
  <section class="py-20 px-6">
    <div class="mx-auto max-w-5xl">
      <h2 class="text-3xl font-bold text-white text-center mb-4">Wheel Repair Services Across Orange County</h2>
      <p class="text-lg text-gray-400 text-center mb-12 max-w-2xl mx-auto">
        From Irvine to Huntington Beach, our mobile technicians bring professional wheel repair to
        your driveway, office parking lot, or anywhere in OC.
      </p>

      <div class="grid gap-8 md:grid-cols-3">
        <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-8 hover:border-gold-500 transition-colors">
          <h3 class="text-xl font-bold text-gold-500 mb-3">Curb Rash Repair</h3>
          <p class="text-gray-400">
            Curb damage on your rims? We repair scrapes, gouges, and scuffs on-site and refinish the
            wheel to match its original look.
          </p>
        </div>
        <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-8 hover:border-gold-500 transition-colors">
          <h3 class="text-xl font-bold text-gold-500 mb-3">Cosmetic Wheel Repair</h3>
          <p class="text-gray-400">
            Scratches, chips, peeling clear coat, and faded finishes — restored to factory quality
            without removing your wheels.
          </p>
        </div>
        <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-8 hover:border-gold-500 transition-colors">
          <h3 class="text-xl font-bold text-gold-500 mb-3">Mobile Service</h3>
          <p class="text-gray-400">
            No shop visits. We come to you anywhere in Orange County with all the tools and materials
            needed for a complete repair.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="py-20 px-6 bg-zinc-950">
    <div class="mx-auto max-w-4xl">
      <h2 class="text-3xl font-bold text-white text-center mb-12">How Mobile Wheel Repair Works in OC</h2>
      <div class="space-y-8">
        <div class="flex gap-6 items-start">
          <span class="flex-shrink-0 w-12 h-12 flex items-center justify-center rounded-full bg-gold-500 text-black font-bold text-xl">1</span>
          <div>
            <h3 class="text-lg font-bold text-white mb-1">Contact Us</h3>
            <p class="text-gray-400">Call, text, or send us a message with photos of the damage and your Orange County location.</p>
          </div>
        </div>
        <div class="flex gap-6 items-start">
          <span class="flex-shrink-0 w-12 h-12 flex items-center justify-center rounded-full bg-gold-500 text-black font-bold text-xl">2</span>
          <div>
            <h3 class="text-lg font-bold text-white mb-1">Get a Quote</h3>
            <p class="text-gray-400">We'll give you a clear, upfront quote based on the wheels and damage — no surprises.</p>
          </div>
        </div>
        <div class="flex gap-6 items-start">
          <span class="flex-shrink-0 w-12 h-12 flex items-center justify-center rounded-full bg-gold-500 text-black font-bold text-xl">3</span>
          <div>
            <h3 class="text-lg font-bold text-white mb-1">We Come to You</h3>
            <p class="text-gray-400">Our technician arrives at your home or office in OC with everything needed for the repair.</p>
          </div>
        </div>
        <div class="flex gap-6 items-start">
          <span class="flex-shrink-0 w-12 h-12 flex items-center justify-center rounded-full bg-gold-500 text-black font-bold text-xl">4</span>
          <div>
            <h3 class="text-lg font-bold text-white mb-1">Drive Away Happy</h3>
            <p class="text-gray-400">Your wheels look brand new — without ever leaving your car at a shop.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Areas -->
  <section class="py-20 px-6">
    <div class="mx-auto max-w-4xl">
      <h2 class="text-3xl font-bold text-white text-center mb-4">Orange County Cities We Serve</h2>
      <p class="text-lg text-gray-400 text-center mb-10">
        Our mobile wheel repair covers Orange County, including:
      </p>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
        {[
          'Irvine', 'Anaheim', 'Huntington Beach', 'Costa Mesa', 'Newport Beach',
          'Santa Ana', 'Orange', 'Fullerton', 'Garden Grove', 'Laguna Beach',
          'Laguna Niguel', 'Mission Viejo', 'Tustin', 'Fountain Valley', 'Brea',
          'Yorba Linda', 'Lake Forest', 'Aliso Viejo',
        ].map((city) => (
          <div class="flex items-center gap-2 text-gray-300">
            <span class="text-gold-500">&#10003;</span>
            {city}
          </div>
        ))}
      </div>
      <p class="mt-8 text-center text-gray-400">
        Not sure if we cover your city? <a href="/quote" class="text-gold-500 font-semibold underline">Contact us</a> —
        we likely do.
      </p>
    </div>
  </section>

    <!-- Before / After -->
  <section class="py-20 px-6 bg-zinc-950">
    <div class="mx-auto max-w-4xl">
      <h2 class="text-3xl font-bold text-white text-center mb-4">Before & After</h2>
      <p class="text-gray-400 text-center mb-10">
        Real results from our wheel repairs in Orange County and beyond.
      </p>
      <div class="text-center">
        <a href="/gallery/" class="inline-block bg-gold-500 hover:bg-gold-400 text-black px-8 py-3 rounded-full font-bold transition-all transform hover:scale-105">
          View Our Gallery
        </a>
      </div>
    </div>
  </section>
  <!-- Why Choose Us -->
  <section class="py-20 px-6 bg-zinc-950">
    <div class="mx-auto max-w-4xl">
      <h2 class="text-3xl font-bold text-white text-center mb-4">Why Orange County Chooses HRZ Wheel Repair</h2>
      <p class="text-lg text-gray-400 text-center mb-12 max-w-2xl mx-auto">
        With over 5,000 wheels restored and 10 years of experience, we're Orange County's trusted mobile wheel repair specialists.
      </p>
      <div class="grid gap-8 md:grid-cols-2">
        <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-8">
          <h3 class="text-xl font-bold text-gold-500 mb-3">10+ Years Experience</h3>
          <p class="text-gray-400">A decade of repairing alloy wheels, curb rash, and cosmetic damage across Los Angeles and Orange County.</p>
        </div>
        <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-8">
          <h3 class="text-xl font-bold text-gold-500 mb-3">5,000+ Wheels Restored</h3>
          <p class="text-gray-400">From BMWs to Teslas, we've restored thousands of wheels to factory condition for satisfied OC customers.</p>
        </div>
        <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-8">
          <h3 class="text-xl font-bold text-gold-500 mb-3">Mobile — We Come to You</h3>
          <p class="text-gray-400">No need to drive to a shop. We perform the repair at your home, office, or anywhere in Orange County.</p>
        </div>
        <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-8">
          <h3 class="text-xl font-bold text-gold-500 mb-3">All Makes & Models</h3>
          <p class="text-gray-400">Audi, BMW, Mercedes, Tesla, Honda, Subaru, Lexus, and more — we repair all alloy wheel finishes.</p>
        </div>
      </div>
    </div>
  </section>


  <!-- FAQ -->
  <section class="py-20 px-6">
    <div class="mx-auto max-w-3xl">
      <h2 class="text-3xl font-bold text-white text-center mb-10">Frequently Asked Questions</h2>
      <div class="space-y-6">
        <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-6">
          <h3 class="text-lg font-bold text-gold-500 mb-2">Does HRZ Wheel Repair come to Orange County?</h3>
          <p class="text-gray-400">
            Yes. Our mobile team serves Orange County including Irvine, Anaheim, Huntington Beach,
            Costa Mesa, Newport Beach, and surrounding cities.
          </p>
        </div>
        <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-6">
          <h3 class="text-lg font-bold text-gold-500 mb-2">What wheel repairs do you handle?</h3>
          <p class="text-gray-400">
            Curb rash repair, cosmetic wheel repair, scuff removal, and alloy wheel restoration — all
            performed on-site at your location.
          </p>
        </div>
               <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-6">
          <h3 class="text-lg font-bold text-gold-500 mb-2">How quickly can you come to OC?</h3>
          <p class="text-gray-400">
            We typically schedule Orange County appointments within a few days, and same-week service
            is usually available. Call or text to check current availability.
          </p>
        </div>
        <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-6">
          <h3 class="text-lg font-bold text-gold-500 mb-2">How much does mobile wheel repair cost in OC?</h3>
          <p class="text-gray-400">
            Pricing depends on the extent of damage and number of wheels. Most curb rash repairs start at an affordable per-wheel rate. Contact us for a free quote based on photos of your damage.
          </p>
        </div>
        <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-6">
          <h3 class="text-lg font-bold text-gold-500 mb-2">Do you repair all types of wheels?</h3>
          <p class="text-gray-400">
            Yes. We repair alloy wheels, including silver, gold, black, and custom finishes. We service all major brands including Audi, BMW, Mercedes, Tesla, Honda, Subaru, Lexus, and more.
          </p>
        </div>
        <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-6">
          <h3 class="text-lg font-bold text-gold-500 mb-2">Do I need to remove my wheels for repair?</h3>
          <p class="text-gray-400">
            No. Our mobile service performs cosmetic wheel repair with the wheels on your car, saving you time and hassle.
          </p>
        </div>
      </div>

  </section>

  <!-- CTA -->
  <section class="py-20 px-6 bg-gradient-to-br from-black via-zinc-900 to-black">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="text-3xl font-bold text-white mb-4">Need Wheel Repair in Orange County?</h2>
      <p class="text-lg text-gray-300 mb-8">
        Mobile curb rash and cosmetic wheel repair across OC. Call, text, or book online.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/quote"
          class="bg-gold-500 hover:bg-gold-400 text-black px-8 py-3 rounded-full font-bold transition-all transform hover:scale-105"
        >
          Get a Free Quote
        </a>
        <a
          href="tel:+16268632885"
          class="border border-gold-500 text-gold-500 hover:bg-gold-500 hover:text-black px-8 py-3 rounded-full font-bold transition-all"
        >
          Call or Text
        </a>
      </div>
    </div>
  </section>

  <!-- Internal link to LA page -->
  <section class="py-10 px-6 text-center">
    <p class="text-gray-500">
      Also serving Los Angeles —
      <a href="/wheel-repair-los-angeles" class="text-gold-500 font-semibold underline">Mobile Wheel Repair Los Angeles</a>
    </p>
  </section>
</Layout>
