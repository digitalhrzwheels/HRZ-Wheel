---
// HRZ Wheel Repair – Mobile Wheel Repair Service Page
// URL: https://hrzwheel.com/mobile-wheel-repair
import Layout from '../layouts/Layout.astro';

const pageData = {
  title: 'Mobile Wheel Repair | We Come to You | HRZ Wheel Repair',
  description:
    'Mobile wheel repair service — curb rash, cosmetic damage, and rim restoration at your home or office. Serving Los Angeles and Orange County, CA.',
  image: '/og-image.png',
};
---

<Layout title={pageData.title} description={pageData.description} image={pageData.image}>
  <section class="bg-gradient-to-br from-zinc-900 to-zinc-800 py-20 text-center">
    <div class="mx-auto max-w-3xl px-6">
      <h1 class="text-4xl font-bold text-white md:text-5xl">Mobile Wheel Repair</h1>
      <p class="mt-4 text-lg text-zinc-300">
        We bring the repair shop to your driveway, office, or parking spot — anywhere in Los
        Angeles or Orange County.
      </p>
      <a
        href="/contact"
        class="mt-8 inline-block rounded-lg bg-amber-500 px-8 py-3 font-semibold text-black hover:bg-amber-400"
      >
        Book a Mobile Visit
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 py-16">
    <h2 class="text-2xl font-bold text-zinc-900">No Shop Visit Required</h2>
    <p class="mt-4 text-zinc-600">
      Traditional wheel repair means leaving your car at a shop for hours — sometimes days. Our
      mobile service eliminates that hassle. We arrive with all the tools, materials, and
      expertise needed to repair your wheels on-site, so you never have to leave your vehicle
      behind.
    </p>

    <h2 class="mt-12 text-2xl font-bold text-zinc-900">What We Repair On-Site</h2>
    <div class="mt-6 grid gap-6 sm:grid-cols-2">
      <div class="rounded-xl border border-zinc-200 p-6">
        <h3 class="font-semibold text-zinc-900">Curb Rash</h3>
        <p class="mt-2 text-zinc-600">Scrapes, gouges, and scuffs from curb contact.</p>
      </div>
      <div class="rounded-xl border border-zinc-200 p-6">
        <h3 class="font-semibold text-zinc-900">Cosmetic Damage</h3>
        <p class="mt-2 text-zinc-600">Scratches, paint chips, and clear coat peeling.</p>
      </div>
      <div class="rounded-xl border border-zinc-200 p-6">
        <h3 class="font-semibold text-zinc-900">Scuffed Rims</h3>
        <p class="mt-2 text-zinc-600">Everyday wear and tear on alloy wheel surfaces.</p>
      </div>
      <div class="rounded-xl border border-zinc-200 p-6">
        <h3 class="font-semibold text-zinc-900">Faded Finishes</h3>
        <p class="mt-2 text-zinc-600">Oxidized or discolored wheels restored to factory shine.</p>
      </div>
    </div>

    <h2 class="mt-12 text-2xl font-bold text-zinc-900">Benefits of Mobile Wheel Repair</h2>
    <ul class="mt-4 space-y-3 text-zinc-600">
      <li class="flex gap-3"><span class="text-amber-500">&#10003;</span> No waiting at a repair shop</li>
      <li class="flex gap-3"><span class="text-amber-500">&#10003;</span> No need to leave your vehicle overnight</li>
      <li class="flex gap-3"><span class="text-amber-500">&#10003;</span> Repairs completed in under an hour per wheel</li>
      <li class="flex gap-3"><span class="text-amber-500">&#10003;</span> Convenient scheduling around your day</li>
      <li class="flex gap-3"><span class="text-amber-500">&#10003;</span> Same quality results as a shop repair</li>
    </ul>

    <div class="mt-12 rounded-xl bg-zinc-50 p-8 text-center">
      <h2 class="text-2xl font-bold text-zinc-900">Schedule Your Mobile Repair</h2>
      <p class="mt-2 text-zinc-600">Available across Los Angeles and Orange County.</p>
      <div class="mt-6 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href="/contact" class="rounded-lg bg-amber-500 px-8 py-3 font-semibold text-black hover:bg-amber-400">
          Book a Visit
        </a>
        <a href="/wheel-repair-los-angeles" class="font-semibold text-amber-600 underline">LA Service Area</a>
        <a href="/wheel-repair-orange-county" class="font-semibold text-amber-600 underline">OC Service Area</a>
      </div>
    </div>
  </section>
</Layout>
